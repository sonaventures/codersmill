    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/starlight": "^0.43.1",
    "@emdash-cms/cloudflare": "^1.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
