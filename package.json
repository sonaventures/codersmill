{
  "name": "website-builder",
  "version": "0.1.0",
  "private": true,
  "description": "CodersMill: the Website Builder tools for building and styling Astro websites, hosted by Coders Mill at codersmill.com.",
  "homepage": "https://codersmill.com",
  "author": {
    "name": "Coders Mill",
    "url": "https://codersmill.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonaventures/codersmill.git"
  },
  "bugs": {
    "url": "https://github.com/sonaventures/codersmill/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:add": "node scripts/website-builder/install-fonts.mjs",
    "test": "node --test",
    "deploy": "astro build && npm run migrate && wrangler deploy",
    "migrate": "emdash migrate --wrangler-config wrangler.jsonc"
  },
