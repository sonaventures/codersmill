---
import Layout from "./layout.astro";
import "../styles/websitebuilder/websitebuilder.css";
import StudioHeader from "../components/websitebuilder/StudioHeader.astro";
import { builderPages } from "../data/website-builder";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = `${Astro.url.pathname.replace(/\/$/, "")}/`;
---

<Layout title={title} description={description} siteName="Website Builder">
  <StudioHeader slot="header" title={title} description={description} />
  <div data-website-builder-content>
    <script is:inline>
      if (
        window.parent !== window &&
        new URLSearchParams(location.search).get("workspace") === "1"
      ) {
        document.documentElement.dataset.builderEmbedded = "";
      }
    </script>
    <slot />
  </div>
  <footer slot="footer" class="site-footer relative z-20" data-studio-footer>
    <div class="footer-inner">
      <div class="footer-intro">
        <a class="footer-wordmark" href="/website-builder/">
          Website Builder
        </a>
        <p>
          Build pages, navigation, colors, themes, and typography for your
          website.
        </p>
      </div>
      <nav aria-label="Website Builder footer">
        <ul class="footer-links">
          {builderPages.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={currentPath === href ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Website Builder</p>
      <p>Your website design tools, together in one place.</p>
    </div>
  </footer>
</Layout>
