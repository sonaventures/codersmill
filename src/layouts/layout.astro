---
import "../styles/global.css";
import Header from "../components/SiteHeader.astro";
import Footer from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
}

const {
  title = "Exclusive Group",
  description = "A central directory for Exclusive Group.",
  showFooter = true,
} = Astro.props;
const fullTitle =
  title === "Exclusive Group" ? title : `${title} | Exclusive Group`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="oklch(96.93% 0.014 78.26)" />
    <script is:inline>
      const themeStorageKey = "exclusive-group-theme";
      let theme;

      try {
        theme = localStorage.getItem(themeStorageKey);
      } catch (error) {
        console.warn("Unable to read the saved theme preference.", error);
      }

      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }

      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      const themeColor =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--canvas-page")
          .trim() ||
        (theme === "dark"
          ? "oklch(12.67% 0.073 267.26)"
          : "oklch(96.93% 0.014 78.26)");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", themeColor);
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot name="header">
      <Header />
    </slot>
    <main id="main-content">
      <slot />
    </main>
    {showFooter && <Footer />}
    <script>
      import "../scripts/intersect";
    </script>
  </body>
</html>
