---
import "../styles/global.css";
// The CodersMill header and footer, with the menu from src/data/site.ts.
import Header from "../components/codersmill/header_5.astro";
import Footer from "../components/codersmill/footer_1.astro";
import {
  host,
  pageDescriptions,
  siteName as defaultSiteName,
} from "../data/site";

interface Props {
  siteName?: string;
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  /**
   * Extra classes for the site header and footer. Their colors and
   * typography are sitewide (sw-header / sw-footer in sitewide.css).
   */
  headerClass?: string;
  footerClass?: string;
}

const {
  siteName = defaultSiteName,
  title = siteName,
  description = pageDescriptions.home,
  showHeader = true,
  showFooter = true,
  headerClass,
  footerClass,
} = Astro.props;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
// Pages live on codersmill.com (`site` in astro.config.mjs).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? host.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: host.url,
  publisher: { "@type": "Organization", name: host.name, url: host.url },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={host.name} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="oklch(96.93% 0.014 78.26)" />
    <script is:inline>
      const themeStorageKey = "website-builder-theme";
      let theme;

      try {
        // Then the docs' (Starlight's) choice, so the two stay linked, and
        // the key saved before the rename.
        theme =
          localStorage.getItem(themeStorageKey) ||
          localStorage.getItem("starlight-theme") ||
          localStorage.getItem("exclusive-group-theme");
      } catch (error) {
        console.warn("Unable to read the saved theme preference.", error);
      }

      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }

      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      const themeColor =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--canvas-page")
          .trim() ||
        (theme === "dark"
          ? "oklch(12.67% 0.073 267.26)"
          : "oklch(96.93% 0.014 78.26)");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", themeColor);
    </script>
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {showHeader && (
      <slot name="header">
        <div class:list={["sw-header", headerClass]}>
          <Header />
        </div>
      </slot>
    )}
    <main id="main-content">
      <slot />
    </main>
    {showFooter && (
      <slot name="footer">
        <div class:list={["sw-footer", footerClass]}>
          <Footer />
        </div>
      </slot>
    )}
    <script>
      import "../scripts/intersect";
    </script>
  </body>
</html>
