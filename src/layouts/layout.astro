---
import "../styles/global.css";
import Header from "../components/SiteHeader.astro";
import Footer from "../components/SiteFooter.astro";

interface Props {
  siteName?: string;
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  /** A theme group header class from groups.css, e.g. sg-sample-header. */
  headerClass?: string;
  /** A theme group footer class from groups.css, e.g. sg-sample-footer. */
  footerClass?: string;
}

const {
  siteName = "Exclusive Group",
  title = siteName,
  description = "A central directory for Exclusive Group.",
  showHeader = true,
  showFooter = true,
  headerClass,
  footerClass,
} = Astro.props;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="oklch(96.93% 0.014 78.26)" />
    <script is:inline>
      const themeStorageKey = "exclusive-group-theme";
      let theme;

      try {
        theme = localStorage.getItem(themeStorageKey);
      } catch (error) {
        console.warn("Unable to read the saved theme preference.", error);
      }

      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }

      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      const themeColor =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--canvas-page")
          .trim() ||
        (theme === "dark"
          ? "oklch(12.67% 0.073 267.26)"
          : "oklch(96.93% 0.014 78.26)");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", themeColor);
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    {showHeader && (
      <slot name="header">
        <Header class={headerClass} />
      </slot>
    )}
    <main id="main-content">
      <slot />
    </main>
    {showFooter && (
      <slot name="footer">
        <Footer class={footerClass} />
      </slot>
    )}
    <script>
      import "../scripts/intersect";
    </script>
  </body>
</html>
