---
import { host, navigation, siteName } from "../data/site";

interface Props {
  /** A theme group footer class, e.g. sg-sample-footer. */
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["site-footer", className]}>
  <div class="footer-inner">
    <div class="footer-intro">
      <a class="footer-wordmark" href="/">
        {siteName}
      </a>
      <p>Build and style Astro websites from ready-made blocks.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        {navigation.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {siteName}</p>
    <p>
      Hosted by <a href={host.url}>{host.name}</a>
    </p>
  </div>
</footer>
