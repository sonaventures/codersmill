---
// A sample illustration with three shapes, one for each SVG fill of the area
// it sits in. Click a shape in the theme builder to edit that fill.
interface Props {
  /** A smaller version without a caption, e.g. for the header. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={["sample-svg", { "sample-svg-compact": compact }]}>
  <svg
    viewBox="0 0 120 64"
    role="img"
    aria-label="Sample SVG with three fills"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle
      cx="44"
      cy="32"
      r="30"
      data-sample-role="svgFill1"
      style="fill: var(--sample-svgFill1)"></circle>
    <path
      d="m44 12 5.9 12 13.1 1.9-9.5 9.3 2.3 13.1L44 42.1l-11.8 6.2 2.3-13.1-9.5-9.3 13.1-1.9Z"
      data-sample-role="svgFill2"
      style="fill: var(--sample-svgFill2)"></path>
    <circle
      cx="98"
      cy="18"
      r="12"
      data-sample-role="svgFill3"
      style="fill: var(--sample-svgFill3)"></circle>
    <circle
      cx="106"
      cy="48"
      r="7"
      data-sample-role="svgFill3"
      style="fill: var(--sample-svgFill3)"></circle>
  </svg>
  {
    !compact && (
      <figcaption>
        SVG fills: disc <code>01</code>, star cutout <code>02</code>, dots{" "}
        <code>03</code>
      </figcaption>
    )
  }
</figure>
