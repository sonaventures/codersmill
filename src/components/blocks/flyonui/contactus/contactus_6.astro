<div class="py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    <div class="mb-12 space-y-4 text-center sm:mb-16 lg:mb-24">
      <p class="text-sm font-medium uppercase">
        Get in touch with us
      </p>
      <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
        Have Questions? Get in Touch!
      </h2>
      <p class="text-xl">
        Our team is ready to help—connect with us to learn more about our
        services and solutions.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="mb-12 flex w-full flex-wrap justify-center gap-6">
      <!-- Call Card -->
      <div class="rounded-xl flex grow flex-row items-center gap-6 border p-6">
        <div class="flex size-11.5 shrink-0 items-center justify-center rounded-xl">
          <span class="icon-[tabler--phone-call] size-6.5"></span>
        </div>
        <div>
          <h3 class="mb-1 text-xl font-semibold">
            Call us today
          </h3>
          <p>+1-316-555-1259</p>
        </div>
      </div>

      <!-- Email Card -->
      <div class="rounded-xl flex grow flex-row items-center gap-6 border p-6">
        <div class="flex size-11.5 shrink-0 items-center justify-center rounded-xl">
          <span class="icon-[tabler--mail] size-6.5"></span>
        </div>
        <div>
          <h3 class="mb-1 text-xl font-semibold">
            Send an Email
          </h3>
          <p>johndoe@gmail.com</p>
        </div>
      </div>

      <!-- Location Card -->
      <div class="rounded-xl flex grow flex-row items-center gap-6 border p-6">
        <div class="flex size-11.5 shrink-0 items-center justify-center rounded-xl">
          <span class="icon-[tabler--globe] size-6.5"></span>
        </div>
        <div>
          <h3 class="mb-1 text-xl font-semibold">
            Visit Our HQ
          </h3>
          <p>La defence, Paris</p>
        </div>
      </div>
    </div>

    <!-- Contact Form Section -->
    <div class="relative flex justify-center md:justify-start">
      <!-- Image -->
      <div class="relative">
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/contact/contact-3.png"
          alt="Modern office hallway"
          class="max-md:hidden md:h-178.5 md:w-170 lg:w-full"
        />
      </div>
      <!-- Form -->
      <div class="rounded-xl border shadow-none max-md:inset-s-1/2 max-md:-translate-x-1/2 md:absolute md:inset-e-0 md:top-1/2 md:w-3/4 md:max-w-130 md:-translate-y-1/2">
        <div class="space-y-6 p-6">
          <div class="space-y-2 text-center">
            <h3 class="text-2xl font-semibold">
              Send us a message
            </h3>
            <p>
              Get in touch with us for any inquiries or support. We're here to
              assist you and ensure your experience is exceptional.
            </p>
          </div>
          <!-- Form -->
          <form class="space-y-6" onsubmit="return false;">
            <div class="w-full">
              <label
                class="mb-2 block text-sm font-medium"
                for="username"
              >
                Full Name
              </label>
              <div class="relative">
                <input
                  type="text"
                  class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                  placeholder="Enter your name here..."
                  id="username"
                />
                <span class="icon-[tabler--user] absolute inset-e-3 top-1/2 size-5.5 shrink-0 -translate-y-1/2"></span>
              </div>
            </div>
            <div class="w-full">
              <label
                class="mb-2 block text-sm font-medium"
                for="useremail"
              >
                Your Email
              </label>
              <div class="relative">
                <input
                  type="text"
                  class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                  placeholder="Enter your email here..."
                  id="useremail"
                />
                <span class="icon-[tabler--mail] absolute inset-e-3 top-1/2 size-5.5 shrink-0 -translate-y-1/2"></span>
              </div>
            </div>
            <div>
              <label
                class="mb-2 block text-sm font-medium"
                for="usermessage"
              >
                Message
              </label>
              <div class="relative">
                <textarea
                  class="w-full resize-none rounded-xl border px-4 py-3 pe-12 focus:outline-none"
                  aria-label="Textarea"
                  placeholder="Enter your message"
                  id="usermessage"
                ></textarea>
                <span class="icon-[tabler--message-circle-2] absolute inset-e-4 top-3 size-6 shrink-0"></span>
              </div>
            </div>
            <button type="submit" class="btn w-full">
              Get Free Quote
            </button>
          </form>
          <p class="text-center">
            I understand that my data will be hold securely in accordance with
            the
            <a
              href="#"
              class="font-medium"
            >
              privacy policy
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
