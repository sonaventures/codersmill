            />
            <span class="icon icon-[tabler--mail] absolute inset-e-3 top-1/2 size-6 shrink-0 -translate-y-1/2"></span>
          </div>
        </div>
        <div>
          <label
            class="mb-2 block text-sm font-medium"
            for="usermessage"
          >
            Message
          </label>
          <div class="relative">
            <textarea
              class="w-full resize-none rounded-xl border px-4 py-3 pe-12 focus:outline-none"
