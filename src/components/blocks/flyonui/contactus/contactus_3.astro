<div class="relative h-full">
  <!-- Background image container with overlay -->
  <div
    class="absolute inset-0 h-3/4 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/contact/contact-1.png')"
  >
    <!-- Dark overlay for better text contrast -->
    <div class="absolute inset-0"></div>
  </div>
  <!-- Content container -->
  <div class="relative mx-auto h-full p-6 md:p-12">
    <a
      href="#"
      title="flyonui"
      class="flex items-center gap-3 text-xl font-bold"
    >
      <img
        src="https://cdn.flyonui.com/fy-assets/logo/logo.png"
        class="size-8"
        alt="brand-logo"
      />
      <span>FlyonUI</span>
    </a>
    <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:px-8">
      <!-- Heading Section -->
      <div class="mb-12 text-center sm:mb-16 lg:mb-24">
        <h2 class="mb-4 text-2xl font-semibold md:text-3xl lg:text-4xl">
          Get in touch with us for more information
        </h2>
        <p class="text-xl">
          If you need help or have a question, we're here for you
        </p>
      </div>
      <div class="rounded-xl border shadow-md">
        <div class="grid gap-10 p-6 lg:grid-cols-7">
          <!-- Form Section -->
          <div class="lg:col-span-4">
            <h2 class="mb-6 text-3xl font-semibold">
              Say hello!
            </h2>
            <form class="space-y-6" onsubmit="return false;">
              <div class="flex gap-6 max-md:flex-col">
                <div class="w-full">
                  <label
                    class="mb-2 block text-sm font-medium"
                    for="username"
                  >
                    Full Name
                  </label>
                  <div class="relative">
                    <input
                      type="text"
                      class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                      placeholder="Enter your name here..."
                      id="username"
                    />
                    <span class="icon-[tabler--user] absolute inset-e-3 top-1/2 size-5.5 shrink-0 -translate-y-1/2"></span>
                  </div>
                </div>
                <div class="w-full">
                  <label
                    class="mb-2 block text-sm font-medium"
                    for="useremail"
                  >
                    Your Email
                  </label>
                  <div class="relative">
                    <input
                      type="text"
                      class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                      placeholder="Enter your email here..."
                      id="useremail"
                    />
                    <span class="icon-[tabler--mail] absolute inset-e-3 top-1/2 size-5.5 shrink-0 -translate-y-1/2"></span>
                  </div>
                </div>
              </div>
              <div>
                <label
                  class="mb-2 block text-sm font-medium"
                  for="usernumber"
                >
                  Phone Number
                </label>
                <div class="relative">
                  <input
                    type="number"
                    class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                    placeholder="Enter your number here..."
                    id="usernumber"
                  />
                  <span class="icon-[tabler--phone] absolute inset-e-3 top-1/2 size-5.5 shrink-0 -translate-y-1/2"></span>
                </div>
              </div>
              <div>
                <label
                  class="mb-2 block text-sm font-medium"
                  for="usermessage"
                >
                  Message
                </label>
                <div class="relative">
                  <textarea
                    class="w-full resize-none rounded-xl border px-4 py-3 pe-12 focus:outline-none"
                    aria-label="Textarea"
                    placeholder="Enter your message"
                    id="usermessage"
                  ></textarea>
                  <span class="icon-[tabler--message-circle-2] absolute inset-e-4 top-3 size-6 shrink-0"></span>
                </div>
              </div>
              <button type="submit" class="btn w-full">
                Send Your Message
              </button>
            </form>
          </div>
          <!-- Contact Information -->
          <div class="space-y-6 lg:col-span-3">
            <div class="rounded-xl border p-6 text-center">
              <h3 class="mb-4 text-xl font-semibold">
                Company Email/Phone
              </h3>
              <p class="mb-2 text-lg break-all">
                johndoe@gmail.com
              </p>
              <p class="text-lg">+148 589 2001 2466</p>
            </div>
            <div class="rounded-xl border p-6 text-center">
              <h3 class="mb-4 text-xl font-semibold">
                Visit Our HQ
              </h3>
              <p class="text-lg">Office 149,</p>
              <p class="text-lg">450 South Brand Brooklyn</p>
              <p class="text-lg">San Diego County,</p>
              <p class="text-lg">CA 91905, USA</p>
            </div>
            <p class="text-center font-medium">
              Opening Hours
              <span>8AM - 5PM</span>
              Everyday
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
