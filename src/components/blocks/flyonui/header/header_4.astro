<header
  x-data="{ open: false, menu: null }"
  x-on:click.outside="menu = null"
  x-on:keydown.escape="menu = null"
  class="flex w-full flex-wrap items-center justify-between gap-2 px-0 py-2 shadow-sm"
>
  <div class="mx-auto w-full md:flex md:flex-col md:items-center">
    <div class="w-full max-w-site px-4 py-3.25 sm:px-6 md:flex md:flex-col md:items-center md:gap-2 lg:px-8">
      <div class="flex w-full items-center justify-between">
        <div class="flex w-1/2 items-center justify-start gap-4 max-md:hidden">
          <a
            href="#"
            class="icon-[tabler--brand-github] size-5"
            aria-label="GitHub"
          ></a>
          <a href="#" class="icon-[tabler--brand-x] size-5" aria-label="X"></a>
          <a
            href="#"
            class="icon-[tabler--brand-discord] size-5"
            aria-label="Discord"
          ></a>
        </div>
        <div class="flex shrink-0 items-center max-md:order-1 max-md:w-1/2 max-md:justify-start">
          <a
            class="flex items-center gap-3 text-xl font-bold"
            href="#"
          >
            <img
              src="https://cdn.flyonui.com/fy-assets/logo/logo.png"
              class="size-8"
              alt="brand-logo"
            />
            FlyonUI
          </a>
        </div>
        <div class="flex w-1/2 items-center justify-end gap-4 max-md:order-3 max-md:w-max sm:gap-6">
          <div class="flex w-full max-w-56 items-center rounded-full border px-3 py-2 max-sm:hidden bg-canvas-01-input border-canvas-01-input-border focus-within:border-accent-01-input-focus">
            <label class="sr-only" for="searchInput">
              Search
            </label>
            <input
              type="search"
              class="min-w-0 grow bg-transparent focus:outline-none text-ink-01-input placeholder:text-ink-01-placeholder"
              placeholder="Search here..."
              id="searchInput"
            />
            <span class="icon-[tabler--search] my-auto ms-1.5 size-5 shrink-0 nav-svg"></span>
          </div>
          <span class="icon-[tabler--search] size-5 cursor-pointer sm:hidden nav-svg"></span>
          <button
            type="button"
            class="button grid size-10 shrink-0 cursor-pointer place-items-center rounded-md border transition-colors md:hidden"
            x-on:click="open = !open"
            x-bind:aria-expanded="open.toString()"
            aria-controls="navbar-block-4"
            aria-label="Toggle navigation"
          >
            <span class="icon-[tabler--menu-2] size-5.5 nav-svg" x-show="!open"></span>
            <span
              class="icon-[tabler--x] size-5.5 nav-svg"
              x-cloak
              x-show="open"
            ></span>
          </button>
        </div>
      </div>
    </div>
    <div class="my-2.5 h-px w-full max-md:hidden"></div>
    <nav aria-label="Main"
      id="navbar-block-4"
      class="max-w-site grow basis-full overflow-hidden px-4 max-md:hidden sm:px-6 lg:px-8"
      x-bind:class="{ 'max-md:hidden': !open }"
