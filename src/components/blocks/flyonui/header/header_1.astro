<header
  x-data="{ open: false, menu: null }"
  x-on:click.outside="menu = null"
  x-on:keydown.escape="menu = null"
  class="flex w-full flex-wrap items-center justify-between gap-2 shadow-sm"
>
  <div class="mx-auto w-full max-w-site px-4 py-4 sm:px-6 lg:flex lg:items-center lg:gap-2 lg:px-8">
    <div class="flex w-1/2 items-center justify-between max-lg:w-full">
      <a
        class="flex items-center gap-3 text-xl font-bold lg:hidden"
        href="#"
      >
        <img
          src="https://cdn.flyonui.com/fy-assets/logo/logo.png"
          class="size-8"
          alt="brand-logo"
        />
        FlyonUI
      </a>

      <div class="flex items-center lg:hidden">
        <span class="icon-[tabler--search] me-6 size-5 cursor-pointer nav-svg"></span>
        <button
          type="button"
          class="button grid size-10 shrink-0 cursor-pointer place-items-center rounded-md border transition-colors"
          x-on:click="open = !open"
          x-bind:aria-expanded="open.toString()"
          aria-controls="navbar-block-1"
          aria-label="Toggle navigation"
        >
          <span class="icon-[tabler--menu-2] size-5.5 nav-svg" x-show="!open"></span>
          <span class="icon-[tabler--x] size-5.5 nav-svg" x-cloak x-show="open"></span>
        </button>
      </div>
    </div>
    <nav aria-label="Main"
      id="navbar-block-1"
      class="grow overflow-hidden max-lg:hidden lg:flex lg:shrink-0 lg:items-center"
      x-bind:class="{ 'max-lg:hidden': !open }"
    >
      <ul id="nav-header" class="flex gap-6 text-base font-medium max-lg:mt-4 max-lg:flex-col lg:items-center lg:gap-16">
        <li>
          <a class="rounded-accent! bg-accent-01-01 text-accent-01-01-text inset-ring inset-ring-accent-01-01-border shadow-accent-01-01-shadow/20 hover:bg-accent-01-01-hover hover:text-accent-01-01-hover-text hover:inset-ring-accent-01-01-hover-border focus-visible:bg-accent-01-01-hover focus-visible:text-accent-01-01-hover-text focus-visible:inset-ring-accent-01-01-hover-border active:inset-ring-accent-01-01-active-border focus-visible:outline-accent-01-focus menu-header px-3 py-2" href="#">
            Home
          </a>
        </li>
        <li>
          <a class="rounded-accent! bg-accent-01-01 text-accent-01-01-text inset-ring inset-ring-accent-01-01-border shadow-accent-01-01-shadow/20 hover:bg-accent-01-01-hover hover:text-accent-01-01-hover-text hover:inset-ring-accent-01-01-hover-border focus-visible:bg-accent-01-01-hover focus-visible:text-accent-01-01-hover-text focus-visible:inset-ring-accent-01-01-hover-border active:inset-ring-accent-01-01-active-border focus-visible:outline-accent-01-focus menu-header px-3 py-2" href="#">
            Products
          </a>
        </li>
        <li class="max-lg:hidden">
          <a
            class="flex items-center gap-3 text-xl font-bold"
            href="#"
          >
            <img
              src="https://cdn.flyonui.com/fy-assets/logo/logo.png"
              class="size-8"
              alt="brand-logo"
            />
            FlyonUI
          </a>
        </li>
        <li>
          <a class="rounded-accent! bg-accent-01-01 text-accent-01-01-text inset-ring inset-ring-accent-01-01-border shadow-accent-01-01-shadow/20 hover:bg-accent-01-01-hover hover:text-accent-01-01-hover-text hover:inset-ring-accent-01-01-hover-border focus-visible:bg-accent-01-01-hover focus-visible:text-accent-01-01-hover-text focus-visible:inset-ring-accent-01-01-hover-border active:inset-ring-accent-01-01-active-border focus-visible:outline-accent-01-focus menu-header px-3 py-2" href="#">
            About Us
          </a>
        </li>
        <li>
          <a class="rounded-accent! bg-accent-01-01 text-accent-01-01-text inset-ring inset-ring-accent-01-01-border shadow-accent-01-01-shadow/20 hover:bg-accent-01-01-hover hover:text-accent-01-01-hover-text hover:inset-ring-accent-01-01-hover-border focus-visible:bg-accent-01-01-hover focus-visible:text-accent-01-01-hover-text focus-visible:inset-ring-accent-01-01-hover-border active:inset-ring-accent-01-01-active-border focus-visible:outline-accent-01-focus menu-header px-3 py-2" href="#">
            Contacts
          </a>
        </li>
      </ul>
    </nav>
    <div class="flex w-1/2 items-center justify-end max-lg:hidden">
      <span class="icon-[tabler--search] size-5 cursor-pointer nav-svg"></span>
    </div>
  </div>
</header>
