<header
  x-data="{ open: false, menu: null }"
  x-on:click.outside="menu = null"
  x-on:keydown.escape="menu = null"
  class="flex w-full flex-wrap items-center justify-between gap-2 px-0 py-2 shadow-sm"
>
  <div class="mx-auto w-full max-w-site px-4 py-4 sm:px-6 md:flex md:items-center md:gap-2 lg:px-8">
    <div class="flex w-max items-center justify-between max-md:w-full">
      <a
        class="flex items-center gap-3 text-xl font-bold"
        href="#"
      >
        <img
          src="https://cdn.flyonui.com/fy-assets/logo/logo.png"
          class="size-8"
          alt="brand-logo"
        />
        FlyonUI
      </a>
      <div class="md:hidden">
        <button
          type="button"
          class="button grid size-10 shrink-0 cursor-pointer place-items-center rounded-md border transition-colors"
          x-on:click="open = !open"
          x-bind:aria-expanded="open.toString()"
          aria-controls="navbar-block-1"
          aria-label="Toggle navigation"
        >
          <span class="button-icon icon-[tabler--menu-2] size-5.5" x-show="!open"></span>
          <span class="button-icon icon-[tabler--x] size-5.5" x-cloak x-show="open"></span>
        </button>
      </div>
    </div>
    <div
      id="navbar-block-1"
      class="grow basis-full overflow-hidden max-md:w-full max-md:hidden md:flex md:items-center md:justify-end"
      x-bind:class="{ 'max-md:hidden': !open }"
    >
      <nav aria-label="Main">
        <ul id="nav-header" class="flex gap-6 text-base font-medium max-md:mt-4 max-md:flex-col md:items-center">
          <li>
            <a href="#">Home</a>
          </li>
          <li>
            <a href="#">Products</a>
          </li>
          <li>
            <a href="#">About Us</a>
          </li>
          <li>
            <a href="#">Contacts</a>
          </li>
        </ul>
      </nav>
      <div class="my-6 h-px w-full md:mx-6 md:my-2 md:h-auto md:w-px md:self-stretch"></div>
      <a href="#" class="cta-anchor btn max-md:w-full">
        Login
      </a>
    </div>
  </div>
</header>
