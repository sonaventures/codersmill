---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="container intro-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="intro-description">{description}</p>
    <div class="btn-group">
      <a class="btn btn-filled" href="/companies/">
        View companies <span aria-hidden="true">→</span>
      </a>
      <a class="btn btn-outline" href="/about/">
        About the group
      </a>
    </div>
  </div>
</section>
