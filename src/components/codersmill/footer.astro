---
import {
  builderLink,
  builderName,
  host,
  navigation,
  siteName,
} from "../../data/site";

interface Props {
  /** A theme group footer class, e.g. sg-sample-footer. */
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["site-footer", className]}>
  <div class="footer-inner">
    <div class="footer-intro">
      <a class="footer-wordmark" href="/">
        {siteName}
      </a>
      <p>
        The home of {builderName}: browser tools for building and styling Astro
        websites from ready-made blocks.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        {navigation.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
        <li>
          <a href={builderLink.href}>{builderLink.label}</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>
      © {new Date().getFullYear()} <a href={host.url}>{host.name}</a>
    </p>
    <p>Your files stay in your project. Nothing is uploaded.</p>
  </div>
</footer>
