---
import Logo from "./logo.astro";
import { navigation } from "../../data/site";

// The CodersMill menu from src/data/site.ts, as a column per section: the
// section's link (Accent 1, menu-header) over its pages.
const currentPath = Astro.url.pathname.replace(/\/?$/, "/");
const accent1 =
  "rounded-accent! bg-accent-01-01 text-accent-01-01-text inset-ring inset-ring-accent-01-01-border shadow-accent-01-01-shadow/20 hover:bg-accent-01-01-hover hover:text-accent-01-01-hover-text hover:inset-ring-accent-01-01-hover-border focus-visible:bg-accent-01-01-hover focus-visible:text-accent-01-01-hover-text focus-visible:inset-ring-accent-01-01-hover-border active:inset-ring-accent-01-01-active-border focus-visible:outline-accent-01-focus";
---

<footer class="p-4 md:p-8 lg:p-10">
  <div class="mx-auto max-w-site text-center">
    <a class="flex justify-center" href="/" aria-label="CodersMill home">
      <Logo class="h-16" fills />
    </a>
    <p class="my-6">
      Open-source library of over 400+ web components and interactive elements
      built for better web.
    </p>
    <nav aria-label="Footer">
      <ul class="mx-auto mb-8 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-8 text-start sm:grid-cols-3 lg:grid-cols-5">
        {navigation.map((section) => (
          <li>
            <a
              href={section.href}
              class={`${accent1} menu-header -mx-2 inline-block px-2 py-1`}
              aria-current={currentPath === section.href ? "page" : undefined}
            >
              {section.label}
            </a>
            <ul class="mt-3 space-y-2 text-sm">
              {section.items.map(({ label, href, external }) => (
                <li>
                  <a
                    href={href}
                    class="hover:underline hover:underline-offset-4"
                    aria-current={currentPath === href ? "page" : undefined}
                    {...(external ? { target: "_blank", rel: "noopener" } : {})}
                  >
                    {label}
                    {external && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
    <span class="text-sm sm:text-center">
      © 2021-2022{" "}
      <a href="#" class="hover:underline">
        Flowbite™
      </a>
      . All Rights Reserved.
    </span>
  </div>
</footer>
