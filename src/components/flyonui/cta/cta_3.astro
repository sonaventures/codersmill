<section class="pt-8 pb-16 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl px-6 pt-20 pb-32 text-center shadow-2xl max-sm:pt-10 max-sm:pb-15">
      <div class="flex flex-col items-center justify-center gap-6">
        <div>
          <span class="inline-flex w-fit items-center rounded-full border px-3.5 py-1.5 text-sm font-medium">
            Subscribe Now
          </span>
        </div>
        <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
          Stay Updated with FlyonUI
        </h2>
        <p class="text-balance lg:w-10/12">
          Want to be the first to know when we add new components, features,
          blocks, or releases? Sign up for our newsletter and stay in the loop.
        </p>
      </div>
      <div class="absolute top-14 left-0 max-sm:top-32">
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/cta/left.svg"
          alt="Left block image"
          class="max-sm:h-25"
        />
      </div>
      <div class="absolute top-14 right-0 max-sm:top-32">
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/cta/right.svg"
          alt="Right block image"
          class="max-sm:h-25"
        />
      </div>
    </div>
    <div class="relative -mt-9.25">
      <form
        onsubmit="return false;"
        class="mx-auto flex h-fit w-fit gap-2.5 rounded-xl border-2 p-3"
      >
        <div class="flex max-w-sm items-center rounded-lg bg-transparent px-3 py-2.5">
          <span class="icon-[tabler--mail] my-auto me-2 size-5.5 shrink-0"></span>
          <label class="sr-only" for="leadingIconDefault">
            Email
          </label>
          <input
            type="email"
            class="min-w-0 grow bg-transparent focus:outline-none"
            placeholder="Your email address"
            id="leadingIconDefault"
            required
          />
        </div>
        <button
          type="submit"
          class="btn max-sm:size-12 max-sm:px-0"
          aria-label="Get started"
        >
          <span class="max-sm:hidden">Get started</span>
          <svg
            width="18"
            height="14"
            viewBox="0 0 18 14"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path class="fill-ink-01-svg-01"
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M13.6783 11.0368L9.65442 5.82339C9.24779 5.29654 8.44959 5.30648 8.0562 5.84329L4.43062 10.7906C4.24226 11.0476 3.94268 11.1995 3.62402 11.1995H2.49548C1.66785 11.1995 1.19846 10.2515 1.70018 9.5933L8.05352 1.25805C8.45167 0.735703 9.2367 0.732477 9.63913 1.25154L16.2769 9.81309C16.7864 10.4702 16.3181 11.4258 15.4866 11.4258H14.4699C14.16 11.4258 13.8676 11.2821 13.6783 11.0368ZM9.62329 10.1549L11.1844 12.0256C11.7278 12.6768 11.2648 13.6663 10.4166 13.6663H7.45051C6.62615 13.6663 6.15586 12.7249 6.65092 12.0657L8.05591 10.195C8.4432 9.67938 9.2101 9.65972 9.62329 10.1549Z"
              fill="currentColor"
            />
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>
