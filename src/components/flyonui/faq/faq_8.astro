<div class="bg-canvas-01 text-ink-01 py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-12 space-y-4 sm:mb-16 lg:mb-24">
      <h2 class="text-ink-01-h2 text-2xl font-semibold md:text-3xl lg:text-4xl">
        Common Questions You Might Have
      </h2>
      <p class="text-ink-01-muted text-xl">
        Use AI algorithms to give users some cool insights!
      </p>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 gap-16 md:grid-cols-2 xl:grid-cols-3">
      <!-- Left Column - Accordion -->
      <div
        class="border-canvas-01-border divide-canvas-01-border h-max divide-y rounded-xl border xl:col-span-2"
        x-data="{ open: 'accommodation-types' }"
      >
        <!-- Accordion Item 1 -->
        <div>
          <button
            type="button"
            id="accommodation-types"
            class="inline-flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-start font-medium"
            x-on:click="open = open === 'accommodation-types' ? null : 'accommodation-types'"
            x-bind:aria-expanded="(open === 'accommodation-types').toString()"
            aria-controls="accommodation-types-content"
          >
            Could you please provide details on the various types of
            accommodations available?
            <span
              class="icon-[tabler--chevron-down] size-4.5 shrink-0 transition-transform duration-300"
              x-bind:class="open === 'accommodation-types' ? 'rotate-180' : ''"
            ></span>
          </button>
          <div
            id="accommodation-types-content"
            class="w-full overflow-hidden"
            aria-labelledby="accommodation-types"
            role="region"
            x-show="open === 'accommodation-types'"
            x-collapse
          >
            <div class="px-5 pb-4">
              <p class="text-ink-01-muted text-base">
                We offer a diverse range of accommodations to suit every
                preference and budget. Our hotels provide luxury and standard
                rooms with full amenities, while our motels offer convenient and
                comfortable stays for travelers. For extended stays or family
                trips, we have fully furnished vacation rentals with kitchen
                facilities and living spaces.
              </p>
            </div>
          </div>
        </div>
        <!-- Accordion Item 2 -->
        <div>
          <button
            type="button"
            id="booking-process"
            class="inline-flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-start font-medium"
            x-on:click="open = open === 'booking-process' ? null : 'booking-process'"
            x-bind:aria-expanded="(open === 'booking-process').toString()"
            aria-controls="booking-process-content"
          >
            What is the process for making a booking?
            <span
              class="icon-[tabler--chevron-down] size-4.5 shrink-0 transition-transform duration-300"
              x-bind:class="open === 'booking-process' ? 'rotate-180' : ''"
            ></span>
          </button>
          <div
            id="booking-process-content"
            class="w-full overflow-hidden"
            aria-labelledby="booking-process"
            role="region"
            x-cloak
            x-show="open === 'booking-process'"
            x-collapse
          >
            <div class="px-5 pb-4">
              <p class="text-ink-01-muted text-base">
                Booking with us is simple and straightforward. Select your
                desired accommodation type, check availability for your dates,
                and complete the reservation through our secure online system.
                You'll receive instant confirmation and detailed information
                about your stay via email.
              </p>
            </div>
          </div>
        </div>
        <!-- Accordion Item 3 -->
        <div>
          <button
            type="button"
            id="cancellation-policy"
            class="inline-flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-start font-medium"
            x-on:click="open = open === 'cancellation-policy' ? null : 'cancellation-policy'"
            x-bind:aria-expanded="(open === 'cancellation-policy').toString()"
            aria-controls="cancellation-policy-content"
          >
            Could you please provide details regarding your cancellation policy?
            <span
              class="icon-[tabler--chevron-down] size-4.5 shrink-0 transition-transform duration-300"
              x-bind:class="open === 'cancellation-policy' ? 'rotate-180' : ''"
            ></span>
          </button>
          <div
            id="cancellation-policy-content"
            class="w-full overflow-hidden"
            aria-labelledby="cancellation-policy"
            role="region"
            x-cloak
            x-show="open === 'cancellation-policy'"
            x-collapse
          >
            <div class="px-5 pb-4">
              <p class="text-ink-01-muted text-base">
                Our flexible cancellation policy allows free cancellation up to
                48 hours before check-in for most bookings. Specific terms may
                vary by property and season. For detailed information, please
                review the cancellation terms provided during the booking
                process.
              </p>
            </div>
          </div>
        </div>
        <!-- Accordion Item 4 -->
        <div>
          <button
            type="button"
            id="modify-booking"
            class="inline-flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-start font-medium"
            x-on:click="open = open === 'modify-booking' ? null : 'modify-booking'"
            x-bind:aria-expanded="(open === 'modify-booking').toString()"
            aria-controls="modify-booking-content"
          >
            Is it possible to modify my booking after it has been confirmed?
            <span
              class="icon-[tabler--chevron-down] size-4.5 shrink-0 transition-transform duration-300"
              x-bind:class="open === 'modify-booking' ? 'rotate-180' : ''"
            ></span>
          </button>
          <div
            id="modify-booking-content"
            class="w-full overflow-hidden"
            aria-labelledby="modify-booking"
            role="region"
            x-cloak
            x-show="open === 'modify-booking'"
            x-collapse
          >
            <div class="px-5 pb-4">
              <p class="text-ink-01-muted text-base">
                Yes, you can modify your confirmed booking through our online
                booking management system or by contacting our customer service
                team. Changes to dates, room types, or guest numbers are subject
                to availability and may affect the pricing.
              </p>
            </div>
          </div>
        </div>
        <!-- Accordion Item 5 -->
        <div>
          <button
            type="button"
            id="pet-policy"
            class="inline-flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-start font-medium"
            x-on:click="open = open === 'pet-policy' ? null : 'pet-policy'"
            x-bind:aria-expanded="(open === 'pet-policy').toString()"
            aria-controls="pet-policy-content"
          >
            Are pets permitted in your accommodations?
            <span
              class="icon-[tabler--chevron-down] size-4.5 shrink-0 transition-transform duration-300"
              x-bind:class="open === 'pet-policy' ? 'rotate-180' : ''"
            ></span>
          </button>
          <div
            id="pet-policy-content"
            class="w-full overflow-hidden"
            aria-labelledby="pet-policy"
            role="region"
            x-cloak
            x-show="open === 'pet-policy'"
            x-collapse
          >
            <div class="px-5 pb-4">
              <p class="text-ink-01-muted text-base">
                Select properties are pet-friendly and welcome your furry
                companions. Additional pet fees and restrictions may apply.
                Please check the specific property details or contact us
                directly to confirm pet policies and arrangements.
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- Right Column - Support Card -->
      <div class="border-accent-01-focus text-ink-01-highlight from-ink-01-highlight/[0.03] to-accent-01-focus/[0.03] h-max justify-self-center rounded-xl border bg-transparent bg-linear-to-br md:max-w-3xl">
        <div class="flex flex-col items-center gap-4 p-6 text-center">
          <span class="icon-[tabler--messages] text-ink-01-highlight mb-2 size-16"></span>
          <h3 class="text-lg font-medium">Need Assistance?</h3>
          <p class="text-ink-01-muted">
            Our team will answer all your questions. we ensure a quick response.
          </p>
          <a href="#" class="btn btn-filled">
            <span class="icon-[tabler--phone] size-5"></span>
            Contact Support Team
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
