<div class="py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header with Soft Badge -->
    <div class="mb-12 rounded-xl px-6 py-12 text-center sm:mb-16 lg:mb-24">
      <div>
        <span class="mb-8 inline-flex w-fit items-center rounded-full border px-3 py-1 text-xs font-medium">
          Questions?
        </span>
      </div>
      <h2 class="mb-3 text-2xl font-bold md:text-3xl lg:text-4xl">
        Frequently Inquired Queries
      </h2>
      <p class="mx-auto mb-8 text-xl">
        Utilize cutting-edge artificial intelligence techniques to deliver
        valuable insights for travelers.
      </p>
      <!-- Search Input with Button -->
      <div class="mx-auto flex max-w-sm gap-3 max-sm:flex-col max-sm:items-center">
        <div class="flex w-full items-center rounded-full border px-4 py-2.5">
          <input
            type="text"
            placeholder="Search your question"
            class="min-w-0 grow bg-transparent focus:outline-none"
          />
        </div>
        <button class="btn w-fit">Search</button>
      </div>
    </div>
    <!-- FAQ Cards Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Card 1 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--briefcase] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            What services does your travel agency provide ?
          </h3>
          <p class="text-base">
            We offer a range of travel services, including flight bookings,
            hotel reservations, tour packages, cruise bookings, travel
            insurance.
          </p>
        </div>
      </div>
      <!-- Card 2 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--book-2] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            How do I book a trip with your agency ?
          </h3>
          <p class="text-base">
            Booking a trip with us is easy! You can book online through our
            website, call our customer service team, or visit our office in
            person.
          </p>
        </div>
      </div>
      <!-- Card 3 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--map-pin] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            Can I customize my travel itinerary ?
          </h3>
          <p class="text-base">
            Absolutely! We specialize in creating tailor-made travel
            experiences. You can customize everything from your flights and
            accommodations to tours and activities.
          </p>
        </div>
      </div>
      <!-- Card 4 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--brand-paypal] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            What are your payment options ?
          </h3>
          <p class="text-base">
            We offer several payment options for your convenience, including
            credit/debit card payments, bank transfers, and online payment
            gateways. We also offer flexible payment plans.
          </p>
        </div>
      </div>
      <!-- Card 5 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--star] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            Do you offer travel insurance ?
          </h3>
          <p class="text-base">
            Yes, we offer comprehensive travel insurance plans that cover a
            variety of needs, including trip cancellations, medical emergencies,
            lost luggage, and more.
          </p>
        </div>
      </div>
      <!-- Card 6 -->
      <div class="rounded-xl border transition-colors duration-300">
        <div class="flex flex-col gap-4 p-6">
          <div class="grid size-11.5 place-items-center rounded-full">
            <span class="icon-[tabler--credit-card] size-6.5"></span>
          </div>
          <h3 class="text-lg font-medium">
            Can you help with visa applications ?
          </h3>
          <p class="text-base">
            Yes, we provide visa assistance services. Our team can guide you
            through the application process, help gather documents, and support
            you until your visa is approved.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
