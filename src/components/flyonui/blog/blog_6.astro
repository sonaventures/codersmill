<div class="py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">
    <div class="mb-12 grid grid-cols-1 gap-16 sm:mb-16 md:grid-cols-2 lg:mb-24">
      <div class="space-y-4">
        <p class="text-sm font-medium uppercase">world-class project</p>
        <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
          Get daily updates and inspiration from our team!
        </h2>
        <p class="text-xl">
          Check out cool new spots, try out yummy local foods, and dive into different cultures.
        </p>
        <a href="#" class="btn">
          See All Blogs
          <span class="icon-[tabler--arrow-right] size-5 rtl:rotate-180"></span>
        </a>
      </div>

      <!-- Right Section - Newsletter -->
      <div class="h-fit rounded-xl border bg-transparent shadow-none">
        <div class="flex flex-col gap-6 p-6">
          <div class="flex gap-4">
            <button
              class="grid size-14 shrink-0 place-items-center rounded-full border"
              aria-label="Circle Soft"
            >
              <span class="icon-[tabler--mail] size-7.5"></span>
            </button>
            <div>
              <h3 class="mb-2 text-lg font-semibold">Link your email for messaging.</h3>
              <p class="text-lg">
                Check out our portfolio for examples of our world-class websites and apps.
              </p>
            </div>
          </div>
          <div class="flex h-fit justify-between gap-2.5 rounded-xl border-2 px-3 py-2">
            <div class="flex max-w-sm grow items-center">
              <span class="icon-[tabler--mail] my-auto me-1.5 size-5 shrink-0"></span>
              <label class="sr-only" for="leadingIconDefault">Email</label>
              <input
                type="email"
                class="grow bg-transparent focus:outline-none"
                placeholder="Your email address"
                id="leadingIconDefault"
              />
            </div>
            <button type="submit" class="btn">Subscribe</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- Blog Card 1 -->
      <a href="#" class="block overflow-hidden rounded-xl border bg-transparent shadow-none">
        <figure>
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/blog/blog-8.png"
            alt="Search and Discovery"
            class="w-full"
          />
        </figure>
        <div class="flex flex-col gap-4 p-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Articles</span>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Post Types</span>
          </div>
          <h3 class="text-xl font-medium">Estate Insights and Advice Corner</h3>
          <div class="flex items-center gap-1.5 py-1">
            <span class="icon-[tabler--clock] size-5"></span>
            <span>Nov 11, 2023</span>
          </div>
        </div>
      </a>
      <!-- Blog Card 2 -->
      <a href="#" class="block overflow-hidden rounded-xl border bg-transparent shadow-none">
        <figure>
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/blog/blog-9.png"
            alt="Dreamscape Realty"
            class="w-full"
          />
        </figure>
        <div class="flex flex-col gap-4 p-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Articles</span>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Post Types</span>
          </div>
          <h3 class="text-xl font-medium">Dreamscape Realty to Real Estate</h3>
          <div class="flex items-center gap-1.5 py-1">
            <span class="icon-[tabler--clock] size-5"></span>
            <span>Dec 3, 2023</span>
          </div>
        </div>
      </a>
      <!-- Blog Card 3 -->
      <a href="#" class="block overflow-hidden rounded-xl border bg-transparent shadow-none">
        <figure>
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/blog/blog-10.png"
            alt="Property Sale Agreement"
            class="w-full"
          />
        </figure>
        <div class="flex flex-col gap-4 p-6">
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Articles</span>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">Post Types</span>
          </div>
          <h3 class="text-xl font-medium">What is Property Agreement?</h3>
          <div class="flex items-center gap-1.5 py-1">
            <span class="icon-[tabler--clock] size-5"></span>
            <span>January 15, 2024</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
