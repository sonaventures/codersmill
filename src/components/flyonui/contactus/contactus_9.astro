<div class="bg-canvas-01 text-ink-01 py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="bg-canvas-contrast absolute inset-x-0 top-0 h-64 overflow-hidden rounded-b-3xl lg:h-72">
      <img
        src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/contact/contact-4.png"
        alt="Office interior with modern workspace"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Content Container -->
    <div class="relative grid gap-8 sm:gap-16 lg:grid-cols-2 lg:gap-24">
      <!-- Contact Information -->
      <div class="space-y-24 max-lg:mt-10">
        <div class="space-y-4">
          <h2 class="text-2xl font-semibold text-white/90 md:text-3xl lg:text-4xl">
            Reach Out to Us
          </h2>
          <p class="text-xl text-white/80">
            Need support, have a query, or looking for collaboration? Let’s
            talk!
          </p>
        </div>
        <div class="space-y-7">
          <div class="space-y-2">
            <h2 class="text-ink-01-h2 text-2xl font-semibold">
              Contact Information
            </h2>
            <p class="text-ink-01-muted">
              Explore new destinations, indulge in local cuisines, and immerse
              yourself in diverse cultures.
            </p>
          </div>
          <div class="space-y-4">
            <!-- Phone -->
            <div class="flex items-center gap-3">
              <span
                class="icon-[tabler--phone] text-ink-01 size-5"
                aria-hidden="true"
              ></span>
              <span class="text-ink-01 font-medium">+1-316-555-1258</span>
            </div>
            <!-- Email -->
            <div class="flex items-center gap-3">
              <span
                class="icon-[tabler--mail] text-ink-01 size-5"
                aria-hidden="true"
              ></span>
              <a
                href="mailto:hadams@hotmail.com"
                class="text-ink-01 font-medium"
              >
                hadams@hotmail.com
              </a>
            </div>
            <!-- Address -->
            <div class="flex items-start gap-3">
              <span
                class="icon-[tabler--map-pin] text-ink-01 size-5"
                aria-hidden="true"
              ></span>
              <address class="text-ink-01 font-medium not-italic">
                802 Pension Rd, Maine 96812, USA
              </address>
            </div>
          </div>
          <!-- Social Links -->
          <div class="flex gap-4" aria-label="Social media links">
            <a href="#">
              <div class="bg-accent-01-canvas text-accent-01-text flex size-8 items-center justify-center rounded-full">
                <span class="icon-[tabler--brand-github] size-5"></span>
              </div>
            </a>
            <a href="#">
              <div class="bg-accent-01-canvas text-accent-01-text flex size-8 items-center justify-center rounded-full">
                <span class="icon-[tabler--brand-discord] size-5"></span>
              </div>
            </a>
            <a href="#">
              <div class="bg-accent-01-canvas text-accent-01-text flex size-8 items-center justify-center rounded-full">
                <span class="icon-[tabler--brand-twitter] size-5"></span>
              </div>
            </a>
            <a href="#">
              <div class="bg-accent-01-canvas text-accent-01-text flex size-8 items-center justify-center rounded-full">
                <span class="icon-[tabler--brand-youtube] size-5"></span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-canvas-01-card-01 border-canvas-01-card-01-border h-fit rounded-xl border">
        <div class="p-6">
          <form class="space-y-6" onsubmit="return false;">
            <div class="flex w-full flex-wrap gap-6">
              <div class="w-auto grow">
                <label class="text-ink-01 mb-2 block text-sm font-medium">
                  Your Name
                </label>
                <input
                  type="text"
                  class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                  placeholder="Enter your name"
                  id="name"
                  required
                />
              </div>
              <div class="w-auto grow">
                <label class="text-ink-01 mb-2 block text-sm font-medium">
                  Your Email
                </label>
                <input
                  type="email"
                  class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                  placeholder="Enter your email"
                  id="email"
                  required
                />
              </div>
            </div>

            <div>
              <label class="text-ink-01 mb-2 block text-sm font-medium">
                Subject
              </label>
              <input
                type="text"
                class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                placeholder="Enter subject"
                id="subject"
                required
              />
            </div>

            <div>
              <label class="text-ink-01 mb-2 block text-sm font-medium">
                Message
              </label>
              <textarea
                class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus h-28 w-full rounded-xl border px-4 py-3 focus:outline-none"
                placeholder="Type your message here..."
                id="message"
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-filled w-full">
              Send Message
              <span
                class="icon-[tabler--send] size-5"
                aria-hidden="true"
              ></span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
