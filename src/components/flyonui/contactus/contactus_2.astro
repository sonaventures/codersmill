<div class="bg-canvas-01 text-ink-01 py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 space-y-4 text-center sm:mb-16 lg:mb-24">
      <h2 class="text-ink-01-h2 text-2xl font-semibold md:text-3xl lg:text-4xl">
        How Can We Help?
      </h2>
      <p class="text-ink-01-muted text-xl">
        Have a question or need assistance? Contact us and let’s find a solution
        together!
      </p>
    </div>
    <div class="bg-canvas-01-card-01 border-canvas-01-card-01-border rounded-xl border shadow-none">
      <div class="grid gap-8 p-6 md:grid-cols-6">
        <!-- Left Side Content -->
        <div class="bg-canvas-contrast rounded-xl relative space-y-7 px-6 py-8 md:col-span-3 md:max-w-lg xl:col-span-2">
          <div class="space-y-2">
            <h2 class="text-2xl font-semibold text-white/90">
              Contact Information
            </h2>
            <p class="text-white/80">
              Explore new destinations, indulge in local cuisines, and immerse
              yourself in diverse cultures.
            </p>
          </div>
          <div class="space-y-7 text-white">
            <!-- Phone -->
            <div class="flex items-start gap-4 text-lg font-medium">
              <span class="icon-[tabler--phone] size-7 shrink-0"></span>
              +1-316-555-1258
            </div>
            <!-- Email -->
            <div class="flex items-start gap-4">
              <span class="icon-[tabler--mail] size-7 shrink-0"></span>
              <a class="text-lg font-medium" href="mailto:hadams@gmail.com">
                hadams@gmail.com
              </a>
            </div>
            <!-- Address -->
            <div class="flex items-start gap-4 text-lg font-medium">
              <span class="icon-[tabler--map-pin] size-7 shrink-0"></span>
              <address class="not-italic">
                802 Pension Rd, Maine 96812, USA
              </address>
            </div>
          </div>
          <svg
            class="absolute inset-s-1/2 -bottom-2 -translate-x-1/2"
            xmlns="http://www.w3.org/2000/svg"
            width="168"
            height="86"
            viewBox="0 0 168 86"
            fill="none"
          >
            <path
              opacity="0.1"
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M133.684 78.3468L83.1004 32.5189C82.712 32.1671 82.1178 32.1747 81.7387 32.5365L35.4116 76.7407C35.2256 76.9182 34.9784 77.0172 34.7213 77.0172H1.00201C0.0901972 77.0172 -0.34591 75.8967 0.325999 75.2803L81.7411 0.591237C82.1211 0.242619 82.7039 0.240148 83.0868 0.585536L167.66 76.8631C168.34 77.4766 167.906 78.6057 166.99 78.6057H134.356C134.108 78.6057 133.868 78.5134 133.684 78.3468ZM82.8091 54.9463L117.559 84.0642C118.275 84.664 117.85 85.8307 116.917 85.8307H50.8922C49.984 85.8307 49.546 84.7176 50.2108 84.0988L81.4855 54.9809C81.8548 54.637 82.4224 54.6222 82.8091 54.9463Z"
              fill="white"
            />
          </svg>
        </div>
        <!-- Form Section -->
        <div class="md:col-span-3 xl:col-span-4">
          <form class="space-y-6" onsubmit="return false;">
            <div class="flex w-full flex-wrap gap-6">
              <!-- Name Input -->
              <div class="w-auto grow">
                <label
                  class="text-ink-01 mb-2 block text-sm font-medium"
                  for="name"
                >
                  Your Name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                  placeholder="Enter your name here..."
                />
              </div>
              <!-- Email Input -->
              <div class="w-auto grow">
                <label
                  class="text-ink-01 mb-2 block text-sm font-medium"
                  for="email"
                >
                  Your Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                  placeholder="Enter your email here..."
                />
              </div>
            </div>
            <!-- Subject Input -->
            <div>
              <label
                class="text-ink-01 mb-2 block text-sm font-medium"
                for="subject"
              >
                Your Subject
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus w-full rounded-xl border px-4 py-3 focus:outline-none"
                placeholder="Enter your subject here..."
              />
            </div>
            <!-- Message Input -->
            <div>
              <label
                class="text-ink-01 mb-2 block text-sm font-medium"
                for="message"
              >
                Message
              </label>
              <textarea
                id="message"
                name="message"
                class="border-canvas-01-border bg-canvas-01 text-ink-01 placeholder:text-ink-01-muted focus:border-accent-01-focus h-28 w-full rounded-xl border px-4 py-3 focus:outline-none"
                placeholder="Type here..."
              ></textarea>
            </div>
            <!-- Submit Button -->
            <button type="submit" class="btn btn-filled max-sm:w-full">
              Send Message
              <span class="icon-[tabler--send] size-5"></span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
