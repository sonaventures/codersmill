<section class="py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-2">
      <!-- Left Side Content -->
      <div>
        <!-- Header -->
        <div class="space-y-4">
          <div>
            <span class="inline-flex items-center gap-1 rounded-full px-2 py-1 text-sm font-semibold">
              Get in touch with us
            </span>
          </div>
          <h2 class="mt-4 text-2xl font-semibold md:text-3xl lg:text-4xl">
            Need a Help? Get in touch with us!
          </h2>
        </div>

        <!-- Contact Info Cards -->
        <div class="space-y-8 p-6">
          <!-- Location Info -->
          <div class="flex items-center gap-8">
            <div class="relative">
              <span class="absolute -top-2 left-2.5 size-10 rounded-full"></span>
              <span class="icon-[tabler--message-circle-2] size-10"></span>
            </div>
            <div class="flex-1 space-y-1">
              <h3 class="text-lg font-medium">
                Ready for some coffee?
              </h3>
              <p class="text-sm">401 Broadway, 24th floor</p>
              <p class="text-sm">Church View, London</p>
            </div>
          </div>

          <!-- Phone Info -->
          <div class="flex items-center gap-8">
            <div class="relative">
              <span class="absolute -top-2 left-2.5 size-10 rounded-full"></span>
              <span class="icon-[tabler--phone-call] size-10"></span>
            </div>
            <div class="flex-1 space-y-1">
              <h3 class="text-lg font-medium">
                Don't hesitate to reach out!
              </h3>
              <p class="text-sm">Phone : 310-2568-4578</p>
              <p class="text-sm">Fax : 310-1298-4836</p>
            </div>
          </div>

          <!-- Email Info -->
          <div class="flex items-center gap-8">
            <div class="relative">
              <span class="absolute -top-2 left-2.5 size-10 rounded-full"></span>
              <span class="icon-[tabler--mail] size-10"></span>
            </div>
            <div class="flex-1 space-y-1">
              <h3 class="text-lg font-medium">
                How can we assist you?
              </h3>
              <p class="text-sm">johndoe@gmail.com</p>
              <p class="text-sm">smithjohn@gmail.com</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Card -->
      <div class="rounded-xl border shadow-none">
        <div class="p-6">
          <h3 class="mb-4 text-2xl font-semibold">Say hello!</h3>

          <form class="space-y-4" onsubmit="return false;">
            <div class="w-full">
              <label
                class="mb-2 block text-sm font-medium"
                for="username"
              >
                Full Name
              </label>
              <div class="relative">
                <input
                  type="text"
                  class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                  placeholder="Enter your name here..."
                  id="username"
                />
                <span class="icon-[tabler--user] absolute inset-e-3 top-1/2 size-6 shrink-0 -translate-y-1/2"></span>
              </div>
            </div>
            <div class="w-full">
              <label
                class="mb-2 block text-sm font-medium"
                for="useremail"
              >
                Your Email
              </label>
              <div class="relative">
                <input
                  type="text"
                  class="w-full rounded-xl border px-4 py-3 pe-11 focus:outline-none"
                  placeholder="Enter your email here..."
                  id="useremail"
                />
                <span class="icon-[tabler--mail] absolute inset-e-3 top-1/2 size-6 shrink-0 -translate-y-1/2"></span>
              </div>
            </div>
            <div>
              <label
                class="mb-2 block text-sm font-medium"
                for="usermessage"
              >
                Message
              </label>
              <div class="relative">
                <textarea
                  class="w-full resize-none rounded-xl border px-4 py-3 pe-12 focus:outline-none"
                  aria-label="Textarea"
                  placeholder="Enter your message"
                  id="usermessage"
                ></textarea>
                <span class="icon-[tabler--message-circle-2] absolute inset-e-4 top-3 size-6 shrink-0"></span>
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn w-full">
              Get Free Quote
            </button>

            <!-- Privacy Policy -->
            <p>
              I understand that my data will be hold securely in accordance with
              the
              <a
                href="#"
                class="font-medium"
              >
                privacy policy
              </a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
