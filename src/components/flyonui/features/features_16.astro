<div class="py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Heading Section -->
    <div class="mb-12 space-y-4 text-center sm:mb-16 lg:mb-24">
      <div class="text-sm font-medium uppercase">
        OUR BEST FEATURES
      </div>
      <h2 class="mx-auto max-w-2xl text-2xl font-semibold md:text-3xl lg:text-4xl">
        With clarity comes momentum. With momentum, opportunity follows.
      </h2>
      <a href="#" class="btn">
        See all features
      </a>
    </div>
    <!-- Content Section -->
    <div
      class="flex flex-col items-center gap-8"
      x-id="['feature-tab', 'feature-panel']"
      x-data="{ tab: 'creating', tabs: ['analytics', 'monitoring', 'creating', 'tool'], move(event) { let index = this.tabs.indexOf(this.tab); if (event.key === 'ArrowRight') index = (index + 1) % this.tabs.length; else if (event.key === 'ArrowLeft') index = (index + this.tabs.length - 1) % this.tabs.length; else if (event.key === 'Home') index = 0; else if (event.key === 'End') index = this.tabs.length - 1; else return; event.preventDefault(); this.tab = this.tabs[index]; this.$nextTick(() => this.$refs[this.tab].focus()); } }"
    >
      <nav
        class="flex w-full overflow-x-auto border-b"
        aria-label="Features Tabs"
        role="tablist"
        aria-orientation="horizontal"
        x-on:keydown="move($event)"
      >
        <button
          type="button"
          class="grow border-b-2 px-4 py-3 font-medium text-nowrap"
          x-ref="analytics"
          x-bind:id="$id('feature-tab', 'analytics')"
          x-bind:aria-controls="$id('feature-panel', 'analytics')"
          x-bind:aria-selected="tab === 'analytics'"
          x-bind:tabindex="tab === 'analytics' ? 0 : -1"
          x-bind:class="tab === 'analytics' ? '' : 'border-transparent'"
          x-on:click="tab = 'analytics'"
          role="tab"
        >
          One Click Analytics
        </button>
        <button
          type="button"
          class="grow border-b-2 px-4 py-3 font-medium text-nowrap"
          x-ref="monitoring"
          x-bind:id="$id('feature-tab', 'monitoring')"
          x-bind:aria-controls="$id('feature-panel', 'monitoring')"
          x-bind:aria-selected="tab === 'monitoring'"
          x-bind:tabindex="tab === 'monitoring' ? 0 : -1"
          x-bind:class="tab === 'monitoring' ? '' : 'border-transparent'"
          x-on:click="tab = 'monitoring'"
          role="tab"
        >
          Real-Time Data Monitoring
        </button>
        <button
          type="button"
          class="grow border-b-2 px-4 py-3 font-medium text-nowrap"
          x-ref="creating"
          x-bind:id="$id('feature-tab', 'creating')"
          x-bind:aria-controls="$id('feature-panel', 'creating')"
          x-bind:aria-selected="tab === 'creating'"
          x-bind:tabindex="tab === 'creating' ? 0 : -1"
          x-bind:class="tab === 'creating' ? '' : 'border-transparent'"
          x-on:click="tab = 'creating'"
          role="tab"
        >
          Custom Dashboard Creation
        </button>
        <button
          type="button"
          class="grow border-b-2 px-4 py-3 font-medium text-nowrap"
          x-ref="tool"
          x-bind:id="$id('feature-tab', 'tool')"
          x-bind:aria-controls="$id('feature-panel', 'tool')"
          x-bind:aria-selected="tab === 'tool'"
          x-bind:tabindex="tab === 'tool' ? 0 : -1"
          x-bind:class="tab === 'tool' ? '' : 'border-transparent'"
          x-on:click="tab = 'tool'"
          role="tab"
        >
          Interactive Reporting Tools
        </button>
      </nav>
      <!-- Tab Content -->
      <div class="w-full">
        <!-- Right Column - Content -->
        <div
          x-cloak
          x-show="tab === 'analytics'"
          x-bind:id="$id('feature-panel', 'analytics')"
          x-bind:aria-labelledby="$id('feature-tab', 'analytics')"
          role="tabpanel"
          tabindex="0"
        >
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-27-1.png"
            alt="Our Story"
            class="rounded-xl size-full border object-cover"
          />
        </div>
        <div
          x-cloak
          x-show="tab === 'monitoring'"
          x-bind:id="$id('feature-panel', 'monitoring')"
          x-bind:aria-labelledby="$id('feature-tab', 'monitoring')"
          role="tabpanel"
          tabindex="0"
        >
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-28-1.png"
            alt="Our Story"
            class="rounded-xl size-full border object-cover"
          />
        </div>
        <div
          x-show="tab === 'creating'"
          x-bind:id="$id('feature-panel', 'creating')"
          x-bind:aria-labelledby="$id('feature-tab', 'creating')"
          role="tabpanel"
          tabindex="0"
        >
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-26.png"
            alt="Our Story"
            class="rounded-xl size-full border object-cover"
          />
        </div>
        <div
          x-cloak
          x-show="tab === 'tool'"
          x-bind:id="$id('feature-panel', 'tool')"
          x-bind:aria-labelledby="$id('feature-tab', 'tool')"
          role="tabpanel"
          tabindex="0"
        >
          <img
            src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-29.png"
            alt="Our Story"
            class="rounded-xl size-full border object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</div>
