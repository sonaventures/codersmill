<div class="bg-canvas-01 text-ink-01 py-8 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="mb-12 space-y-4 text-center sm:mb-16 lg:mb-24">
      <h2 class="text-ink-01-h2 text-2xl font-semibold md:text-3xl lg:text-4xl">
        Build, Brand, and
        <span class="relative z-1 font-bold">
          Launch Your Dreams SaaS
          <span
            class="from-accent-01-focus absolute inset-s-0 bottom-0 -z-1 h-0.5 w-full bg-linear-to-r to-transparent to-100% max-sm:hidden"
            aria-hidden="true"
          ></span>
        </span>
        in Record Time
      </h2>
      <p class="text-ink-01-muted text-xl">
        JetShip is your all-in-one starter kit for building and launching a
        thriving subscription or one-time purchase SaaS business.
      </p>
    </div>

    <!-- Feature Section with Accordion -->
    <div class="grid items-start gap-10 lg:grid-cols-2 xl:gap-20">
      <div class="space-y-6">
        <div class="space-y-2">
          <div class="flex items-center gap-4">
            <div class="shrink-0">
              <div class="bg-accent-01-focus/10 text-ink-01-highlight rounded-lg grid size-11 place-items-center">
                <span class="icon-[tabler--rocket] size-8"></span>
              </div>
            </div>
            <h2 class="text-ink-01-highlight text-xl font-semibold">
              Launch your app quickly
            </h2>
          </div>
          <h2 class="text-ink-01-h3 text-3xl font-semibold">
            Production-Ready
          </h2>
          <p class="text-ink-01-muted">
            JetShip provides all the essential tools and resources needed to
            launch your project efficiently.
          </p>
        </div>
        <div class="accordion accordion-shadow *:accordion-item-active:shadow-md">
          <div class="accordion-item active" id="production-ready">
            <button
              class="accordion-toggle inline-flex items-center justify-between text-start font-semibold"
              aria-controls="production-ready-collapse"
              aria-expanded="true"
            >
              <span class="inline-flex items-center gap-x-4">
                <span class="icon-[tabler--plane-departure] text-ink-01 size-6"></span>
                Ready for Production
              </span>
              <span class="icon-[tabler--chevron-left] accordion-item-active:-rotate-90 size-4.5 shrink-0 transition-transform duration-300 rtl:-rotate-180"></span>
            </button>
            <div
              id="production-ready-collapse"
              class="accordion-content transition-height w-full overflow-hidden duration-300"
              aria-labelledby="production-ready"
              role="region"
            >
              <div class="px-5 pb-4">
                <p class="text-ink-01-muted">
                  Login is accessing an existing account, registration is
                  creating a new one by providing necessary information.
                </p>
              </div>
            </div>
          </div>
          <div class="accordion-item" id="clean-code">
            <button
              class="accordion-toggle inline-flex items-center justify-between text-start font-semibold"
              aria-controls="clean-code-collapse"
              aria-expanded="false"
            >
              <span class="inline-flex items-center gap-x-4">
                <span class="icon-[tabler--code] text-ink-01 size-6"></span>
                Clean Code
              </span>
              <span class="icon-[tabler--chevron-left] accordion-item-active:-rotate-90 size-4.5 shrink-0 transition-transform duration-300 rtl:-rotate-180"></span>
            </button>
            <div
              id="clean-code-collapse"
              class="accordion-content transition-height hidden w-full overflow-hidden duration-300"
              aria-labelledby="clean-code"
              role="region"
            >
              <div class="px-5 pb-4">
                <p class="text-ink-01-muted">
                  Our codebase follows best practices and is well-documented for
                  easy maintenance.
                </p>
              </div>
            </div>
          </div>
          <div class="accordion-item" id="deployment">
            <button
              class="accordion-toggle inline-flex items-center justify-between text-start font-semibold"
              aria-controls="deployment-collapse"
              aria-expanded="false"
            >
              <span class="inline-flex items-center gap-x-4">
                <span class="icon-[tabler--hand-click] text-ink-01 size-6"></span>
                1-Click Deployment
              </span>
              <span class="icon-[tabler--chevron-left] accordion-item-active:-rotate-90 size-4.5 shrink-0 transition-transform duration-300 rtl:-rotate-180"></span>
            </button>
            <div
              id="deployment-collapse"
              class="accordion-content transition-height hidden w-full overflow-hidden duration-300"
              aria-labelledby="deployment"
              role="region"
            >
              <div class="px-5 pb-4">
                <p class="text-ink-01-muted">
                  Deploy your application with a single click to your preferred
                  hosting platform.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Dashboard Image -->
      <div class="bg-accent-01-focus/10 rounded-xl relative mt-auto overflow-hidden px-6 pt-14 max-lg:shrink-0">
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-1.png"
          alt="Dashboard Preview"
          class="mb-0 hidden w-full object-cover"
          id="production-ready-image"
        />
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-1-1.png"
          alt="Clean code Preview"
          class="mb-0 hidden w-full object-cover"
          id="clean-code-image"
        />
        <img
          src="https://cdn.flyonui.com/fy-assets/blocks/marketing-ui/features/features-1-2.png"
          alt="Deployment Preview"
          class="mb-0 hidden w-full object-cover"
          id="deployment-image"
        />
      </div>
    </div>
  </div>
</div>
