    <div class="mb-11 flex flex-col-reverse items-center justify-between gap-9 lg:flex-row">
      <!-- Text Content -->
      <div class="max-w-3xl">
        <div class="mb-6 space-y-4">
          <h2 class="text-2xl font-semibold md:text-3xl lg:text-4xl">
            Features that you need.
          </h2>
