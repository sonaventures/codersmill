            <span class="icon-[tabler--bell-ringing] size-5"></span>
            Email Notifications
          </button>
          <button
            type="button"
            class="btn hover:bg-transparent"
            id="tabs-segment-item-3"
            data-tab="#tabs-segment-3"
            aria-controls="tabs-segment-3"
            role="tab"
            aria-selected="false"
          >
            <span class="icon-[tabler--shield-check] size-5"></span>
            Field Validations
          </button>
          <button
            type="button"
            class="btn hover:bg-transparent"
            id="tabs-segment-item-4"
            data-tab="#tabs-segment-4"
            aria-controls="tabs-segment-4"
            role="tab"
            aria-selected="false"
          >
