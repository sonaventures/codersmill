          <button
            type="button"
            class="btn active hover:bg-transparent"
            id="tabs-segment-item-1"
            data-tab="#tabs-segment-1"
            aria-controls="tabs-segment-1"
            role="tab"
            aria-selected="true"
          >
            <span class="icon-[tabler--upload] size-5"></span>
            Upload Files
          </button>
          <button
            type="button"
            class="btn hover:bg-transparent"
            id="tabs-segment-item-2"
            data-tab="#tabs-segment-2"
            aria-controls="tabs-segment-2"
            role="tab"
            aria-selected="false"
