      <!-- Navigation Arrows -->
      <button
        type="button"
        class="absolute top-1/2 inset-s-0 z-1 grid size-11.5 -translate-y-1/2 place-items-center rounded-full border disabled:opacity-50"
        aria-label="Previous testimonial"
        x-on:click="go(page - 1)"
        x-bind:disabled="page === 0"
      >
        <span class="icon-[tabler--arrow-left] size-5.5"></span>
      </button>
      <button
        type="button"
        class="absolute top-1/2 inset-e-0 z-1 grid size-11.5 -translate-y-1/2 place-items-center rounded-full border disabled:opacity-50"
        aria-label="Next testimonial"
        x-on:click="go(page + 1)"
        x-bind:disabled="page >= pages - 1"
      >
        <span class="icon-[tabler--arrow-right] size-5.5"></span>
      </button>

      <!-- Pagination Dots -->
      <div class="absolute inset-x-0 -bottom-8 flex justify-center gap-2">
        <template x-for="number in pages" x-bind:key="number">
          <button
            type="button"
            class="size-3 rounded-full"
            x-bind:class="page === number - 1 ? '' : ''"
            x-bind:aria-label="'Go to testimonial page ' + number"
            x-bind:aria-current="page === number - 1 ? 'true' : null"
            x-on:click="go(number - 1)"
          ></button>
        </template>
      </div>
