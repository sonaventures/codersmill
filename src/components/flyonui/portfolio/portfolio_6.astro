        </button>
        <div class="flex items-center justify-center gap-2">
          <template x-for="number in pages" x-bind:key="number">
            <button
              type="button"
              class="size-4 rounded-full"
              x-bind:class="page === number - 1 ? '' : ''"
              x-bind:aria-label="'Go to portfolio page ' + number"
              x-bind:aria-current="page === number - 1 ? 'true' : null"
              x-on:click="go(number - 1)"
            ></button>
          </template>
        </div>
        <button
          type="button"
          class="btn min-h-10 px-4 disabled:opacity-50"
          aria-label="Next portfolio page"
          x-on:click="go(page + 1)"
          x-bind:disabled="page >= pages - 1"
