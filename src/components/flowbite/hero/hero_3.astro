<section class="bg-[url('https://flowbite.s3.amazonaws.com/blocks/marketing-ui/hero/coast-house-view.jpg')] bg-no-repeat bg-cover bg-center bg-canvas-hero bg-blend-multiply text-ink-hero">
  <div class="relative py-8 px-4 mx-auto max-w-screen-xl text-ink-hero lg:py-16 xl:px-0 z-1">
      <div class="mb-6 max-w-screen-md lg:mb-0">
          <h1 class="mb-4 text-4xl font-extrabold tracking-tight leading-tight text-ink-hero-h1 md:text-5xl lg:text-6xl">Every home is a destination</h1>
          <p class="mb-6 font-light text-ink-hero-muted lg:mb-8 md:text-lg lg:text-xl">The best of Luxury Retreats is now Flowbite Luxe—offering the world's most extraordinary homes with the highest standard of service.</p>
          <a href="#" class="inline-flex items-center py-3 px-5 font-medium text-center text-cta-01-text rounded-lg bg-cta-01 hover:brightness-95 focus:ring-4 focus:outline-none focus:ring-accent-01-focus inset-ring inset-ring-cta-01-border hover:bg-cta-01-hover hover:text-cta-01-hover-text focus-visible:bg-cta-01-hover focus-visible:text-cta-01-hover-text">
              Sign In / Register
          </a>
      </div> 
      <form action="#" class="grid gap-y-4 p-4 mt-8 w-full bg-canvas-01-card-01 rounded lg:gap-x-4 lg:grid-cols-9 lg:mt-12">
          <div class="lg:col-span-3">
              <label for="location-form" class="sr-only">Location</label>
              <div class="relative">
                  <div class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
                      <svg class="w-5 h-5 text-ink-01-muted" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path></svg>
                  </div>
                  <input type="text" id="location-form" class="bg-canvas-01-input-card border border-canvas-01-input-border text-ink-01-input text-sm rounded-lg focus:ring-accent-01-input-focus focus:border-accent-01-input-focus block w-full pl-10 p-2.5" placeholder="Search destinations">
              </div>
          </div>
          <div date-rangepicker datepicker-orientation="top" class="grid grid-cols-2 gap-x-4 lg:col-span-3">
              <div class="relative">
                    <div class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
                        <svg class="w-5 h-5 text-ink-01-muted" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
                    </div>
                    <input name="start" type="text" class="bg-canvas-01-input-card border border-canvas-01-input-border text-ink-01-input sm:text-sm rounded-lg focus:ring-accent-01-input-focus focus:border-accent-01-input-focus block w-full pl-10 p-2.5" placeholder="Check in">
                </div>
              <div class="relative">
                <div class="flex absolute inset-y-0 left-0 items-center pl-3 pointer-events-none">
                    <svg class="w-5 h-5 text-ink-01-muted" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
                </div>
                <input name="end" type="text" class="bg-canvas-01-input-card border border-canvas-01-input-border text-ink-01-input sm:text-sm rounded-lg focus:ring-accent-01-input-focus focus:border-accent-01-input-focus block w-full pl-10 p-2.5" placeholder="Check out">
            </div>
          </div>
          <div class="lg:col-span-1">
              <label for="guests" class="sr-only">Select number of guests</label>
              <select id="guests" class="bg-canvas-01-input-card border border-canvas-01-input-border text-ink-01-input text-sm rounded-lg focus:ring-accent-01-input-focus focus:border-accent-01-input-focus block w-full p-2.5">
                  <option>Add guests</option>
                  <option>1</option>
                  <option>2</option>
                  <option>3</option>
                  <option>4</option>
                  <option>5+</option>
              </select>
          </div>
          <button type="submit" class="lg:col-span-2 justify-center md:w-auto text-cta-01-text bg-cta-01 hover:brightness-95 focus:ring-4 focus:outline-none focus:ring-accent-01-focus font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center inset-ring inset-ring-cta-01-border hover:bg-cta-01-hover hover:text-cta-01-hover-text focus-visible:bg-cta-01-hover focus-visible:text-cta-01-hover-text">
              <svg class="mr-2 -ml-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path></svg>
              Search
          </button>
      </form>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/datepicker.min.js"></script>