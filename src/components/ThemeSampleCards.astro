---
import { cardCanvasRoles } from "../data/style-groups";
---

<div class="sample-cards">
  {cardCanvasRoles
    .filter(({ part }) => part === "background")
    .map(({ key, card }) => (
      <article
        class="sample-card"
        data-sample-card={card}
        style={`--card-canvas:var(--sample-${key});--card-border:var(--sample-${key}Border);--card-shadow:var(--sample-${key}Shadow)`}
      >
        <span class="card-number">{card}</span>
        <h3>Card {card}</h3>
        <p>
          Style this card's canvas, border, and shadow independently of the
          other cards in this area.
        </p>
      </article>
    ))}
</div>

<style>
  .sample-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .sample-card {
    padding: 1rem;
    background: var(--card-canvas);
    color: var(--sample-cardText);
    border: 1px solid var(--card-border);
    box-shadow: 0 4px 12px
      color-mix(in srgb, var(--card-shadow) 12%, transparent);
    border-radius: 0.5rem;
    overflow-wrap: anywhere;
  }
  .card-number {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h3 {
    color: var(--sample-h3);
    font-size: 1rem;
    font-weight: 650;
    margin: 1.5rem 0 0.75rem;
  }
  p {
    font-size: 0.85rem;
    line-height: 1.75;
  }
  @media (max-width: 1050px) {
    .sample-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .sample-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
