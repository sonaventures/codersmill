---
import Header from "./SiteHeader.astro";
import { builderPages } from "../data/website-builder";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = `${Astro.url.pathname.replace(/\/$/, "")}/`;
---

<div class="studio-header" data-studio-header data-studio-chrome>
  <Header title="Website Builder">
    <div class="studio-intro">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <div slot="actions" class="studio-links">
      <nav aria-label="Website Builder">
        {builderPages.map(({ label, href }) => (
          <a
            class="studio-link"
            href={href}
            aria-current={currentPath === href ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
      <a class="studio-link" href="/template/">
        Theme template &rarr;
      </a>
    </div>
  </Header>
</div>

<style>
  .studio-header {
    background: var(--canvas-page);
    color: var(--ink-page);
  }
  .studio-header :global(.site-header) {
    background: var(--canvas-page);
    color: var(--ink-page);
    border-color: var(--canvas-page-border);
    box-shadow: 0 8px 24px
      color-mix(in srgb, var(--canvas-page-shadow) 5%, transparent);
  }
  .studio-header :global(.theme-toggle) {
    background: var(--accent-page-canvas);
    color: var(--accent-page-text);
    border-color: var(--accent-page-border);
  }
  .studio-header :global(.theme-toggle:hover) {
    background: var(--accent-page-focus);
  }
  .studio-header :global(.theme-toggle:focus-visible) {
    outline-color: var(--accent-page-focus);
  }
  .studio-header :global(.header-inner) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    width: calc(100% - 3rem);
    max-width: 80rem;
    min-height: 0;
    padding-block: 0.65rem;
  }
  .studio-header :global(.header-inner > div:first-child) {
    min-width: 0;
  }
  .studio-header :global(.header-actions) {
    display: contents;
  }
  .studio-links,
  .studio-links nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .studio-header :global(.theme-switcher) {
    grid-column: 2;
  }
  .studio-links {
    grid-column: 3;
    justify-self: end;
    justify-content: flex-end;
  }
  .studio-links nav {
    justify-content: flex-end;
  }
  .studio-header :global(.header-inner > div:first-child > span) {
    font-size: 1rem;
    color: var(--ink-page);
  }
  .studio-intro h1 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink-page-first-header);
    line-height: 1.1;
    margin: 0.15rem 0 0.25rem;
  }
  .studio-intro p {
    color: var(--ink-page);
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .studio-link {
    font-size: 0.75rem;
    color: var(--accent-page-focus);
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .studio-link[aria-current="page"] {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }
  @media (max-width: 760px) {
    .studio-header :global(.header-inner) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      width: calc(100% - 2rem);
      gap: 0.5rem;
    }
    .studio-links {
      grid-column: 1 / -1;
      max-width: 100%;
      justify-self: start;
      justify-content: flex-start;
    }
    .studio-links nav {
      justify-content: flex-start;
    }
  }
</style>
