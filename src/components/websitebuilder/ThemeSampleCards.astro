---
import { cardCanvasRoles } from "../../data/theme-groups";
---

<div class="sample-cards">
  {cardCanvasRoles
    .filter(({ part }) => part === "background")
    .map(({ key, card }) => (
      <article
        class="sample-card"
        data-sample-card={card}
        style={`--card-canvas:var(--sample-${key});--card-border:var(--sample-${key}Border);--card-shadow:var(--sample-${key}Shadow)`}
      >
        <p class="card-number">Card {card}</p>
        <span class="sample-heading-level">H2</span>
        <h2>Card {card}</h2>
        <span class="sample-heading-level">H3</span>
        <h3>A card with a clear focus</h3>
        <p>
          Add a short description that explains what makes this card useful.
        </p>
      </article>
    ))}
</div>
<article
  class="sample-subsection"
  data-sample-card="subsection"
  style="--card-canvas:var(--sample-subsection);--card-border:var(--sample-card03Border);--card-shadow:var(--sample-card03Shadow)"
>
  <p class="card-number">Subsection / large card</p>
  <span class="sample-heading-level">H2</span>
  <h2>A subsection with room to explore</h2>
  <span class="sample-heading-level">H3</span>
  <h3>A supporting idea</h3>
  <p>
    Use this larger card for a related topic, a deeper explanation, or a
    highlighted piece of content.
  </p>
</article>
