---
import Layout from "../../layouts/website-builder.astro";
import { paletteImportExample, paletteShades } from "../../data/palette.js";
---

<Layout
  title="Color Family Editor"
  description="Add and remove source color families."
>
  <section
    class="palette-editor w-full items-start px-4 sm:px-6 lg:px-8 lg:has-[>.color-guide[open]]:grid-cols-[minmax(16rem,20rem)_minmax(0,1fr)]"
    data-palette-editor
  >
    <details class="color-guide group min-w-0 lg:sticky lg:top-4" open>
      <summary class="w-fit cursor-pointer rounded border border-canvas-page-border bg-canvas-page px-4 py-3 font-semibold">
        <span class="group-open:hidden">Show color editor guide</span>
        <span class="hidden group-open:inline">Hide color editor guide</span>
      </summary>
      <aside
        class="mt-2 grid max-h-[50dvh] min-w-0 gap-4 overflow-y-auto rounded-lg border border-canvas-page-border bg-canvas-page p-4 lg:max-h-[calc(100dvh-6rem)]"
        aria-labelledby="color-guide-title"
        tabindex="0"
      >
        <header>
          <h2 id="color-guide-title">Color editor guide</h2>
          <p>
            Choose the <strong>websitebuilder project folder</strong> to add or
            remove color families. You can also choose its <code>src</code>{" "}
            folder to add or import families. Both options save to{" "}
            <code>src/styles/themes/colors.css</code>.
          </p>
          <p>
            This requires a browser that supports the File System Access API,
            such as Chrome or Edge, and a secure connection or localhost. Files
            are read locally and are not uploaded.
          </p>
          <p>
            The editor remembers your folder for this tab and reconnects after a
            development-page reload. If your browser asks for permission again,
            select <strong>Reconnect project</strong>; you do not need to find
            the folder again.
          </p>
        </header>

        <section aria-labelledby="import-format-title" class="min-w-0">
          <h3 id="import-format-title" class="font-semibold">
            Import color families from text files
          </h3>
          <p id="import-format-help">
            Choose one or more plain-text UTF-8 files ending in .txt or .css, up
            to 1 MB combined. Use one declaration per line in the format
            <code>--color-FAMILY-SHADE: oklch(L% C H);</code>. L is lightness
            (0-100%), C is chroma (0 or greater), and H is hue (0-360 degrees).
            Include the semicolon after every color.
          </p>
          <p>
            Each family needs all 11 shades: {paletteShades.join(", ")}. Use a
            unique lowercase family name starting with a letter, with letters,
            numbers, and single hyphens between words (up to 60 characters). Do
            not use built-in names such as blue or red, existing family names,
            or the reserved names custom, theme, none, and solid. Do not repeat
            a shade within the same family.
          </p>
          <p>
            For multiple families, put each complete set in the same file or
            select several files together using Ctrl-click (Command-click on
            Mac) or Shift-click. Every family needs a different name. CSS
            wrappers such as :root are optional; JSON, commas, and code fences
            are not needed.
          </p>
          <p>
            Choose your project folder or its <code>src</code> folder, then use{" "}
            <strong>Import color families</strong>
            below. Review families using the selector, then click{" "}
            <strong>Save all imported families to colors.css</strong> to save
            every family from all selected files at once. Your name and shade
            edits are included. Nothing is saved if any family is invalid or
            already exists. Use <strong>Add family</strong> to save only the
            selected family instead.
          </p>
          <details class="min-w-0">
            <summary class="cursor-pointer">
              Example .txt file with two complete families
            </summary>
            <pre class="mt-4 max-w-full overflow-x-auto rounded border border-canvas-page-border p-4 text-sm"><code>{paletteImportExample}</code></pre>
          </details>
          <a
            class="w-fit wrap-anywhere underline"
            href={`data:text/plain;charset=utf-8,${encodeURIComponent(paletteImportExample + "\n")}`}
            download="color-families.txt"
          >
            Download example color-families.txt
          </a>
        </section>
      </aside>
    </details>

    <div class="grid min-w-0 gap-4">
      <div class="editor-toolbar">
        <button type="button" id="open-project">
          Choose project folder
        </button>
        <button type="button" id="open-colors-file">
          Choose colors.css file
        </button>
        <button type="button" id="reconnect-project" hidden>
          Reconnect project
        </button>
        <span id="project-name">No project selected</span>
      </div>
      <p id="editor-status" role="status" aria-live="polite">
        Select the websitebuilder project root or its src folder to begin, or
        choose src/styles/themes/colors.css directly.
      </p>
      <div id="editor-content" hidden>
        <section aria-labelledby="add-title">
          <h2 id="add-title">Add a color family</h2>
          <p>
            Enter an OKLCH color for each shade, or import one or more .txt or
            .css files containing complete families. Review the values before
            saving.
          </p>
          <form id="add-family">
            <p>Import color families (.txt or .css)</p>
            <div class="editor-toolbar">
              <button
                type="button"
                id="choose-import-file"
                aria-describedby="import-format-help"
              >
                Choose File
              </button>
              <button type="button" id="add-imported-families" disabled>
                Save all imported families to colors.css
              </button>
            </div>
            <p id="import-status" role="status" hidden></p>
            <input
              id="import-ramp"
              type="file"
              hidden
              multiple
              accept=".txt,.css,text/plain,text/css"
            />
            <p>
              For example: <code>--color-ocean-50: oklch(97% 0.01 240);</code>
            </p>
            <div id="import-family-control" hidden>
              <label for="import-family">Imported family</label>
              <select id="import-family"></select>
            </div>
            <button class="w-fit" type="submit">
              Add family
            </button>
            <label for="family-name">Family name</label>
            <input
              id="family-name"
              name="family"
              required
              pattern="[a-z][a-z0-9]*(?:-[a-z0-9]+)*"
              maxlength="60"
              placeholder="ocean-blue"
            />
            <p>Use lowercase letters, numbers, and hyphens.</p>
            <div class="shade-grid">
              {paletteShades.map((shade) => (
                <label>
                  <span>{shade}</span>
                  <span
                    class="shade-swatch"
                    data-shade-swatch={shade}
                    aria-hidden="true"
                  ></span>
                  <input
                    type="text"
                    name={`shade-${shade}`}
                    required
                    placeholder="oklch(62.6% 0.128 243.6)"
                    aria-label={`Shade ${shade}`}
                  />
                </label>
              ))}
            </div>
          </form>
        </section>

        <section
          class="mx-auto w-full max-w-screen-lg"
          aria-labelledby="families-title"
        >
          <h2 id="families-title">Current families</h2>
          <p id="removal-help">
            If you opened <code>src</code>, removing families first asks for the
            project folder containing <code>src</code> and
            <code>public</code>. Removal is blocked when the family is
            explicitly referenced in those folders or in this browser's saved
            theme groups. Dynamically constructed references, groups in other
            browsers, and external files cannot be checked.
          </p>
          <div class="editor-toolbar">
            <button
              type="button"
              id="open-project-for-removal"
              aria-describedby="removal-help"
              hidden
            >
              Connect project folder for removal
            </button>
            <button
              type="button"
              id="remove-all-families"
              aria-describedby="removal-help"
              disabled
            >
              Remove all current families
            </button>
            <p id="removal-status" role="status"></p>
          </div>
          <div id="family-list"></div>
          <dialog
            id="remove-family-dialog"
            class="m-auto max-w-[min(28rem,90vw)] rounded-lg border border-canvas-page-border bg-canvas-page p-6 text-ink-page backdrop:bg-black/50"
            aria-labelledby="remove-family-title"
            aria-describedby="remove-family-prompt"
          >
            <h3 id="remove-family-title" class="font-semibold">
              Remove color family
            </h3>
            <p id="remove-family-prompt"></p>
            <form method="dialog" class="editor-toolbar">
              <button value="cancel" autofocus>
                Cancel
              </button>
              <button id="confirm-remove-families" value="remove">
                Remove family
              </button>
            </form>
          </dialog>
        </section>
      </div>
    </div>
    <script>
      import "../../scripts/websitebuilder/palette-editor.js";
    </script>
  </section>
</Layout>
