---
import Layout from "../../layouts/website-builder.astro";
import {
  typographyElements,
  typographyProperties,
} from "../../data/typography-builder.js";

const sampleText: Record<string, string> = {
  p: "Thoughtful typography makes every story easier to read. Give your words room to breathe.",
  em: "A little emphasis goes a long way.",
  strong: "Make the important words stand out.",
  code: 'const message = "Hello, typography!";',
  cite: "The Website Builder Handbook",
  pre: 'function greet(name) {\n  return "Hello, " + name;\n}',
  blockquote: "Good typography gives every idea a clear voice.",
};
---

<Layout
  title="Typography Builder"
  description="Set site-wide typography and overrides for sections by ID."
>
  <div class="container grid gap-8 pt-12" data-typography-builder>
    <header class="grid max-w-3xl gap-3">
      <p>
        Set site-wide styles for headings, paragraphs, emphasis, strong text,
        code, citations, preformatted text, and block quotations. Add a section
        ID to override just that section, for example
        <code>&lt;section id="about"&gt;</code>.
      </p>
      <p>
        Blank fields keep existing site styles, or follow site-wide defaults
        when editing a section. Changes stay in the preview until you save the
        stylesheet. Saved rules override Tailwind typography utilities. Inline
        styles, important declarations, and more-specific unlayered CSS can
        still take priority.
      </p>
    </header>

    <p class="text-sm">
      In Chrome or Edge on localhost or HTTPS, click Save to project and choose
      the project folder containing <code>src</code> and <code>public</code>.
      Saving replaces only <code>src/styles/themes/typography.css</code>. In
      other browsers, use Download CSS and replace that file manually.
    </p>

    <div class="grid items-start gap-8 lg:grid-cols-2">
      <div class="grid min-w-0 gap-6">
        <form id="add-typography-section" class="grid gap-2">
          <label for="typography-section-id" class="font-semibold">
            Add a section ID
          </label>
          <div class="flex flex-wrap gap-2">
            <input
              id="typography-section-id"
              required
              maxlength="120"
              placeholder="about"
              aria-describedby="typography-id-help"
              class="min-w-0 flex-1 rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
            />
            <button type="submit" class="btn btn-outline">
              Add section
            </button>
          </div>
          <p id="typography-id-help" class="text-sm">
            Enter the exact, case-sensitive ID without the #. This does not
            create a section; add the matching ID in your page markup.
          </p>
        </form>

        <div class="grid gap-2">
          <label for="typography-scope" class="font-semibold">
            Editing scope
          </label>
          <select id="typography-scope" class="typography-control">
            <option value="">Site-wide defaults</option>
          </select>
          <button
            type="button"
            id="remove-typography-section"
            class="btn btn-outline justify-self-start"
            disabled
          >
            Remove section override
          </button>
        </div>

        <form id="typography-form" class="grid gap-5">
          <div class="grid gap-2">
            <label for="typography-element" class="font-semibold">
              Element
            </label>
            <select id="typography-element" class="typography-control">
              {typographyElements.map((element) => (
                <option>{element}</option>
              ))}
            </select>
          </div>
          <p id="typography-editing" class="font-semibold"></p>
          <div class="grid gap-4 sm:grid-cols-2">
            {typographyProperties.map((property) => (
              <div class="grid content-start gap-2">
                <label
                  for={`typography-${property.key}${property.presets ? "-preset" : ""}`}
                >
                  {property.label}
                </label>
                {property.options ? (
                  <select
                    id={`typography-${property.key}`}
                    data-typography-property={property.key}
                    class="typography-control"
                  >
                    <option value="">Default / no override</option>
                    {Object.entries(property.options).map(([value, label]) => (
                      <option value={value}>{label}</option>
                    ))}
                  </select>
                ) : (
                  <select
                    id={`typography-${property.key}-preset`}
                    data-typography-preset={property.key}
                    class="typography-control"
                  >
                    <option value="">Default / no override</option>
                    {Object.entries(property.presets).map(([value, label]) => (
                      <option value={value}>{label}</option>
                    ))}
                    <option value="custom">Custom value...</option>
                  </select>
                )}
                {property.presets && (
                  <div
                    data-typography-custom={property.key}
                    class="grid gap-2"
                    hidden
                  >
                    <label for={`typography-${property.key}`}>
                      Custom {property.label.toLowerCase()}
                    </label>
                    <input
                      id={`typography-${property.key}`}
                      data-typography-property={property.key}
                      class="typography-control"
                      placeholder={property.placeholder}
                      autocomplete="off"
                      spellcheck="false"
                      disabled
                    />
                  </div>
                )}
              </div>
            ))}
          </div>
          <p class="text-sm">
            Choose Tailwind presets such as text-4xl, font-bold, leading-tight,
            tracking-wide, or text-sky-600. Presets use Tailwind's default
            values and change only the labeled property; set line height
            separately from font size. Font and color tokens follow the site's
            theme.
          </p>
          <p class="text-sm">
            Choose Custom value to enter sizes in px, rem, em, or %. Custom line
            height also accepts a number or normal; letter spacing accepts px,
            rem, em, 0, or normal. Custom color accepts hex, including alpha.
            Font choices use installed fonts or site font tokens; no fonts are
            downloaded.
          </p>
          <button
            type="button"
            id="reset-typography-element"
            class="btn btn-outline justify-self-start"
          >
            Reset this element
          </button>
        </form>
      </div>

      <aside
        class="grid min-w-0 gap-4 lg:sticky lg:top-6"
        aria-label="Typography preview"
      >
        <h2 class="font-display text-2xl">Live preview</h2>
        <p>
          Compare the defaults with the selected section. All{" "}
          {typographyElements.length}
          elements are shown.
        </p>
        <div
          class="grid gap-6 overflow-auto rounded border border-canvas-page-border p-5"
          data-typography-preview
        >
          {["defaults", "section"].map((kind) => (
            <div class="grid gap-3" data-typography-sample={kind}>
              <div
                class="border-b border-canvas-page-border pb-2 text-sm font-semibold"
                data-sample-label
              >
                {kind === "defaults"
                  ? "Site-wide defaults"
                  : "Selected section"}
              </div>
              <section class="grid gap-3 wrap-break-word" data-sample-content>
                {typographyElements.map((Element) => (
                  <div class="min-w-0">
                    <span class="text-xs opacity-70" data-sample-element-label>
                      {Element}
                    </span>
                    <Element>
                      {sampleText[Element] ??
                        `${Element.toUpperCase()} - A place for your next idea`}
                    </Element>
                  </div>
                ))}
              </section>
            </div>
          ))}
        </div>
        <details>
          <summary class="cursor-pointer">Generated CSS</summary>
          <pre class="mt-3 max-h-80 overflow-auto rounded border border-canvas-page-border p-4 text-xs"><code id="typography-css"></code></pre>
        </details>
      </aside>
    </div>

    <div
      role="group"
      aria-label="Typography file actions"
      class="sticky bottom-0 z-30 grid gap-2 rounded-t-xl border border-canvas-page-border bg-canvas-page p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] text-ink-page shadow-lg sm:px-4"
    >
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-filled" id="save-typography">
          Save to project
        </button>
        <button type="button" class="btn btn-outline" id="download-typography">
          Download CSS
        </button>
        <button type="button" class="btn btn-outline" id="import-typography">
          Import builder CSS
        </button>
        <input id="typography-file" type="file" accept=".css,text/css" hidden />
      </div>
      <p id="typography-status" role="status" aria-live="polite" class="text-sm">
        Loading saved project typography.
      </p>
    </div>
  </div>
  <script>
    import "../../scripts/typography-builder.js";
  </script>
</Layout>

<style>
  .typography-control {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--canvas-page-border);
    border-radius: 0.25rem;
    background: var(--canvas-page);
    color: var(--ink-page);
    padding: 0.75rem;
  }
</style>
