---
import Layout from "../../layouts/website-builder.astro";
---

<Layout
  title="Page Builder"
  description="Create pages from the project's Astro components."
>
  <section class="container grid max-w-5xl gap-8 py-12" data-page-builder>
    <header class="grid gap-3">
      <p>
        Choose your websitebuilder project folder to create a page directly in
        <code>src/pages</code>. The layout adds the site header and footer
        automatically.
      </p>
      <p>
        To color the page and its components, first create theme groups in the
        <a class="underline" href="/website-builder/theme-builder/">
          Theme Builder
        </a>{" "}
        and select <strong>Save classes to groups.css</strong>. They then appear
        here under <strong>Page theme group</strong> and
        <strong>Theme group</strong>.
      </p>
      <p>
        Folder access requires Chrome or Edge on localhost or HTTPS. Files stay
        on your computer.
      </p>
    </header>

    <div class="flex flex-wrap items-center gap-4">
      <button class="btn btn-filled" type="button" id="open-page-project">
        Choose project folder
      </button>
      <span id="page-project-name">No project selected</span>
    </div>
    <p id="page-builder-status" role="status" aria-live="polite">
      Choose the project folder to begin.
    </p>
    <a
      id="created-page-link"
      class="text-accent-page-focus underline"
      target="_blank"
      rel="noopener"
      hidden
    >
      Open the new page in a new tab
    </a>

    <form id="page-builder-form" hidden>
      <fieldset id="page-builder-fields" class="grid gap-6">
        <div class="grid gap-2">
          <label for="page-name" class="font-semibold">
            Page name
          </label>
          <input
            id="page-name"
            required
            maxlength="120"
            placeholder="For example, Our Services"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          />
          <p id="page-path" class="text-sm" aria-live="polite">
            Enter a name to see the file path.
          </p>
        </div>
        <div class="grid gap-2">
          <label for="page-description" class="font-semibold">
            Page description (optional)
          </label>
          <textarea
            id="page-description"
            rows="2"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          ></textarea>
        </div>
        <div class="grid gap-2">
          <label for="page-style-class" class="font-semibold">
            Page theme group (optional)
          </label>
          <p class="text-sm">
            Wraps the whole page, between the header and footer, in a page class
            saved by the theme builder in
            <code>src/styles/themes/groups.css</code>.
          </p>
          <select
            id="page-style-class"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          ></select>
        </div>
        <div class="grid gap-2">
          <label for="available-components" class="font-semibold">
            Available components
          </label>
          <p class="text-sm">
            Pick an Astro component from <code>src/components</code>, including
            its subfolders. Components with unsupported properties, slots, or
            files over 5 MB are listed but cannot be added.
          </p>
          <select
            id="available-components"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          ></select>
          <div class="grid gap-2">
            <label for="component-section-id" class="text-sm font-semibold">
              Section ID (optional)
            </label>
            <p class="text-sm">
              Name the section so menus and links can jump to it, for example
              <code>pricing</code> for <code>/your-page/#pricing</code>. Pick a
              suggested name from <code>src/styles/themes/id.css</code> or enter
              your own. IDs are not used for styling; use a theme group for
              that.
            </p>
            <div class="flex flex-wrap gap-2">
              <select
                id="component-section-id"
                class="min-w-[200px] flex-1 rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
              >
                <option value="">No section ID</option>
              </select>
              <input
                id="component-custom-id"
                placeholder="Or enter custom ID"
                maxlength="120"
                class="min-w-[180px] flex-1 rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
              />
            </div>
          </div>
          <div class="grid gap-2">
            <label for="component-style-class" class="text-sm font-semibold">
              Theme group (optional)
            </label>
            <p class="text-sm">
              Colors this component with a hero or section class from a theme
              group saved by the theme builder.
            </p>
            <select
              id="component-style-class"
              class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
            ></select>
          </div>
          <div class="grid gap-3 rounded border border-canvas-page-border p-4">
            <label class="flex items-center gap-2 text-sm font-semibold">
              <input
                type="checkbox"
                id="copy-before-add"
                aria-controls="copy-before-add-fields"
              />
              Save a copy before adding (optional)
            </label>
            <p class="text-sm">
              Saves the component under a new name in a folder of your choice
              inside <code>src/components</code>, then adds the copy to the
              page. The original stays unchanged.
            </p>
            <div id="copy-before-add-fields" class="grid gap-3" hidden>
              <div class="flex flex-wrap gap-3">
                <div class="grid min-w-[180px] flex-1 gap-1">
                  <label for="copy-name" class="text-sm font-semibold">
                    Name
                  </label>
                  <input
                    id="copy-name"
                    maxlength="120"
                    autocomplete="off"
                    placeholder="For example, HomeHero"
                    class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
                  />
                </div>
                <div class="grid min-w-[180px] flex-1 gap-1">
                  <label for="copy-folder" class="text-sm font-semibold">
                    Folder in src/components
                  </label>
                  <select
                    id="copy-folder"
                    class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
                  ></select>
                </div>
                <div
                  class="grid min-w-[180px] flex-1 gap-1"
                  id="copy-new-folder-field"
                  hidden
                >
                  <label for="copy-new-folder" class="text-sm font-semibold">
                    New folder
                  </label>
                  <input
                    id="copy-new-folder"
                    maxlength="150"
                    autocomplete="off"
                    placeholder="For example, custom/home"
                    class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
                  />
                </div>
              </div>
              <p id="copy-path-preview" class="text-sm" aria-live="polite"></p>
            </div>
          </div>
          <button
            class="btn btn-outline justify-self-start"
            type="button"
            id="add-component"
          >
            Add component
          </button>
        </div>
        <section class="grid gap-3" aria-labelledby="selected-components-title">
          <h2 id="selected-components-title" class="font-display text-2xl">
            Components in page order
          </h2>
          <p id="selected-components-empty">No components added yet.</p>
          <p class="text-sm">
            Use <strong>Make a copy</strong> on a component to save it under a
            new name and folder in <code>src/components</code>. That component
            then uses the copy, so you can customize it without changing the
            original.
          </p>
          <ol id="selected-components" class="grid list-none gap-4 p-0"></ol>
          <datalist id="component-folders"></datalist>
        </section>
        <button
          class="btn btn-filled justify-self-start"
          type="submit"
          id="create-page"
        >
          Create page
        </button>
      </fieldset>
    </form>
  </section>
  <script>
    import "../../scripts/websitebuilder/page-builder.js";
  </script>
</Layout>
