---
import Layout from "../../layouts/website-builder.astro";
---

<Layout
  title="Page Builder"
  description="Create pages from the project's Astro components."
>
  <section class="container grid max-w-5xl gap-8 py-12" data-page-builder>
    <header class="grid gap-3">
      <p>
        Choose your websitebuilder project folder to create a page directly in
        <code>src/pages</code>. The layout adds the site header and footer
        automatically.
      </p>
      <p>
        Folder access requires Chrome or Edge on localhost or HTTPS. Files stay
        on your computer.
      </p>
    </header>

    <div class="flex flex-wrap items-center gap-4">
      <button class="btn btn-filled" type="button" id="open-page-project">
        Choose project folder
      </button>
      <span id="page-project-name">No project selected</span>
    </div>
    <p id="page-builder-status" role="status" aria-live="polite">
      Choose the project folder to begin.
    </p>
    <a
      id="created-page-link"
      class="text-accent-page-focus underline"
      target="_blank"
      rel="noopener"
      hidden
    >
      Open the new page in a new tab
    </a>

    <form id="page-builder-form" hidden>
      <fieldset id="page-builder-fields" class="grid gap-6">
        <div class="grid gap-2">
          <label for="page-name" class="font-semibold">
            Page name
          </label>
          <input
            id="page-name"
            required
            maxlength="120"
            placeholder="For example, Our Services"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          />
          <p id="page-path" class="text-sm" aria-live="polite">
            Enter a name to see the file path.
          </p>
        </div>
        <div class="grid gap-2">
          <label for="page-description" class="font-semibold">
            Page description (optional)
          </label>
          <textarea
            id="page-description"
            rows="2"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          ></textarea>
        </div>
        <div class="grid gap-2">
          <label for="available-components" class="font-semibold">
            Available components
          </label>
          <p class="text-sm">
            Pick an Astro component from <code>src/components</code>, including
            its subfolders. Components with unsupported properties, slots, or
            files over 5 MB are listed but cannot be added.
          </p>
          <select
            id="available-components"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          ></select>
          <div class="grid gap-2">
            <label for="component-section-id" class="text-sm font-semibold">
              Section ID (optional)
            </label>
            <p class="text-sm">
              Assign an ID to the outer <code>&lt;section&gt;</code> element
              from
              <code>src/styles/theme/id.css</code> or enter a custom ID.
            </p>
            <div class="flex flex-wrap gap-2">
              <select
                id="component-section-id"
                class="min-w-[200px] flex-1 rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
              >
                <option value="">No section ID</option>
              </select>
              <input
                id="component-custom-id"
                placeholder="Or enter custom ID"
                maxlength="120"
                class="min-w-[180px] flex-1 rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
              />
            </div>
          </div>
          <button
            class="btn btn-outline justify-self-start"
            type="button"
            id="add-component"
          >
            Add component
          </button>
        </div>
        <div class="grid gap-2">
          <label for="component-save-path" class="font-semibold">
            Save a copy of the selected component (optional)
          </label>
          <p class="text-sm">
            Copies the component selected above to a new file under
            <code>src/components</code> so you can rename and customize it. The
            original template stays unchanged. Use <code>/</code> for
            subfolders, for example <code>custom/my-hero</code>.
          </p>
          <input
            id="component-save-path"
            maxlength="200"
            placeholder="For example, custom/my-hero"
            class="w-full rounded border border-canvas-page-border bg-canvas-page p-3 text-ink-page"
          />
          <button
            class="btn btn-outline justify-self-start"
            type="button"
            id="save-component"
          >
            Save component copy
          </button>
        </div>
        <section class="grid gap-3" aria-labelledby="selected-components-title">
          <h2 id="selected-components-title" class="font-display text-2xl">
            Components in page order
          </h2>
          <p id="selected-components-empty">No components added yet.</p>
          <ol id="selected-components" class="grid list-none gap-4 p-0"></ol>
        </section>
        <button
          class="btn btn-filled justify-self-start"
          type="submit"
          id="create-page"
        >
          Create page
        </button>
      </fieldset>
    </form>
  </section>
  <script>
    import "../../scripts/websitebuilder/page-builder.js";
  </script>
</Layout>
