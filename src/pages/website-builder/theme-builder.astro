---
import Layout from "../../layouts/website-builder.astro";
import ThemeSampleCards from "../../components/website-builder/ThemeSampleCards.astro";
import ThemeSampleIcon from "../../components/website-builder/ThemeSampleIcon.astro";
import ThemeSampleSection from "../../components/website-builder/ThemeSampleSection.astro";
import ThemeSampleExtras from "../../components/website-builder/ThemeSampleExtras.astro";
import ThemeSampleSvg from "../../components/website-builder/ThemeSampleSvg.astro";
import ThemeSampleSvgTypes from "../../components/website-builder/ThemeSampleSvgTypes.astro";
import ThemeSitewideBar from "../../components/website-builder/ThemeSitewideBar.astro";
import { sitewideAreas } from "../../data/website-builder/sitewide";
import css from "../../styles/themes/colors.css?raw";
import {
  builtinPaletteFamilies,
  readPalette,
} from "../../data/website-builder/palette.js";
import {
  typographyElements,
  typographyLabel,
  typographyProperties,
} from "../../data/website-builder/typography-builder.js";
import { classGroupAreas } from "../../data/website-builder/group-classes";
import {
  colorRoles,
  defaultColorReference,
  isColorRoleVisible,
  paletteFamilies,
  paletteShades,
  contentWidthPresets,
  radiusPresets,
  radiusTargets,
  regions,
  cardTargets,
  regionColorRoles,
  roleGroups,
  semanticToken,
  setPaletteFamilies,
  type Region,
} from "../../data/website-builder/theme-groups";

setPaletteFamilies(readPalette(css));
const builtinFamilyKeys = new Set(builtinPaletteFamilies.map(({ key }) => key));
const pickerFamilies = [...paletteFamilies].sort(
  (a, b) =>
    Number(builtinFamilyKeys.has(a.key)) - Number(builtinFamilyKeys.has(b.key)),
);
const regionStyle = (region: Region) =>
  regionColorRoles
    .map(({ key }) => `--sample-${key}:${defaultColorReference(region, key)}`)
    .join(";");
const sections = [
  {
    title: "A place for your next idea",
    subtitle: "Make the first impression count",
    detail: "A little contrast goes a long way",
    fourth: "The details make it yours",
  },
  {
    title: "Find your balance",
    subtitle: "Color sets the tone",
    detail: "Keep the details in harmony",
    fourth: "A little space to breathe",
  },
  {
    title: "Better together",
    subtitle: "Four cards, one visual language",
    detail: "A collection worth exploring",
    fourth: "Every part has a place",
  },
  {
    title: "Give an idea the spotlight",
    subtitle: "One card. A clear focus.",
    detail: "Room for something special",
    fourth: "Keep the message close",
  },
  {
    title: "Two sides of the story",
    subtitle: "Build a balanced layout",
    detail: "Different perspectives, shared purpose",
    fourth: "Make space for both",
  },
  {
    title: "Bring it all together",
    subtitle: "Finish with confidence",
    detail: "Your next step starts here",
    fourth: "Ready for what comes next",
  },
];
const sampleMenu = [
  {
    label: "Discover",
    links: [
      { label: "Our ideas", section: 1 },
      { label: "Our approach", section: 2 },
    ],
  },
  {
    label: "Services",
    links: [
      { label: "What we do", section: 3 },
      { label: "In focus", section: 4 },
    ],
  },
  {
    label: "Projects",
    links: [
      { label: "Featured work", section: 4 },
      { label: "Collaborations", section: 5 },
    ],
  },
  {
    label: "About",
    links: [
      { label: "Our story", section: 5 },
      { label: "Next steps", section: 6 },
    ],
  },
];
---

<Layout
  title="Theme Builder"
  description="Explore color combinations and save reusable theme groups."
>
  <div class="selector-shell" data-selector>
    <div class="selector-workspace">
      <div class="preview-column">
        <section
          class="sample-global"
          id="selector-global"
          data-region="global"
          style={regionStyle("page")}
          aria-labelledby="selector-global-heading"
        >
          <ThemeSitewideBar label="Global" />
          <div class="sample-container">
            <p class="sample-kicker">Global / sitewide</p>
            <h2 id="selector-global-heading">Calls to action</h2>
            <p>
              Not part of a theme group: these apply on every page, whatever
              theme group is used.
            </p>
            <div class="sample-buttons">
              <button
                type="button"
                class="bg-cta-01 text-cta-01-text inset-ring inset-ring-cta-01-border hover:bg-cta-01-hover hover:text-cta-01-hover-text focus-visible:bg-cta-01-hover focus-visible:text-cta-01-hover-text"
                data-cta="primary"
              >
                CTA 01 <ThemeSampleIcon />
              </button>
              <button
                type="button"
                class="bg-cta-02 text-cta-02-text inset-ring inset-ring-cta-02-border hover:bg-cta-02-hover hover:text-cta-02-hover-text focus-visible:bg-cta-02-hover focus-visible:text-cta-02-hover-text"
                data-cta="secondary"
              >
                CTA 02
              </button>
              <button
                type="button"
                class="bg-cta-03 text-cta-03-text inset-ring inset-ring-cta-03-border hover:bg-cta-03-hover hover:text-cta-03-hover-text focus-visible:bg-cta-03-hover focus-visible:text-cta-03-hover-text"
                data-cta="tertiary"
              >
                CTA 03 <ThemeSampleIcon />
              </button>
            </div>
          </div>
        </section>
        <div
          class="sample-page"
          id="selector-sample-page"
          data-region="page"
          style={regionStyle("page")}
        >
          <div class="sample-id-bar sample-id-bar-page" data-studio-chrome>
            <div class="sample-id-bar-info">
              <span class="sample-id-bar-dot"></span>
              <strong>Page</strong>
            </div>
            <p class="sample-class-name">
              Class:
              <code data-group-class="page">Name the group to see it</code>
            </p>
          </div>
          <header
            class="sample-header"
            data-region="header"
            style={regionStyle("header")}
          >
            <ThemeSitewideBar label="Header" className="sw-header" />
            <div class="sample-container">
              <a
                class="sample-logo"
                href="#selector-sample-page"
                aria-label="Sample Website Builder home"
              >
                <ThemeSampleSvg compact />
                <span class="text-brand-01">Brand01</span>
                <span class="sample-logo-group text-brand-02">Brand02</span>
              </a>
              <nav class="sample-navigation" aria-label="Sample navigation">
                <ul>
                  {sampleMenu.map(({ label, links }) => (
                    <li>
                      <details name="sample-navigation">
                        <summary>{label}</summary>
                        <ul class="sample-submenu">
                          {links.map(({ label, section }) => (
                            <li>
                              <a href={`#selector-section-${section}`}>
                                {label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </ul>
              </nav>
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Contact <ThemeSampleIcon />
                </button>
              </div>
            </div>
          </header>
          <ThemeSampleSection
            region="hero"
            id="selector-hero"
            label="Hero"
            title="Make a bold beginning"
            subtitle="A first impression with purpose"
            detail="Give your message room to shine"
            fourth="The details make it yours"
            style={regionStyle("hero")}
          />
          <div class="sample-page-intro">
            <div class="sample-container">
              <p class="sample-kicker">Page canvas</p>
              <span class="sample-heading-level">H1</span>
              <h1>A theme with purpose</h1>
              <span class="sample-heading-level">H2</span>
              <h2>Canvas, accent, and ink</h2>
              <span class="sample-heading-level">H3</span>
              <h3>A shared visual language</h3>
              <span class="sample-heading-level">H4</span>
              <h4>A detail to bring it together</h4>
              <p>
                Explore your page-level tokens here, then refine each section
                below.
              </p>
              <p class="sample-muted" data-sample-role="muted">
                Muted text for supporting details, with{" "}
                <mark class="sample-highlight" data-sample-role="highlight">
                  highlight text
                </mark>{" "}
                for emphasis.
              </p>
              <ThemeSampleExtras id="selector-page" />
              <ThemeSampleSvg />
              <ThemeSampleSvgTypes />
              <div class="sample-contrast" data-sample-role="contrastCanvas">
                <strong data-sample-role="contrastText">Contrast band</strong>
                <span data-sample-role="contrastText">
                  A page-wide background that stands apart from every area.
                </span>
              </div>
              <div
                class="sample-buttons"
                role="group"
                aria-label="Page canvas actions"
              >
                <button type="button" class="sample-primary">
                  Accent 1 <ThemeSampleIcon />
                </button>
                <button type="button" class="sample-secondary">
                  Accent 2 <ThemeSampleIcon />
                </button>
                <a class="sample-action-link" href="#selector-sample-page">
                  Accent 3 <ThemeSampleIcon />
                </a>
              </div>
              <p>
                <a class="sample-inline-link" href="#selector-section-1">
                  Explore the sections <ThemeSampleIcon />
                </a>
              </p>
              <ThemeSampleCards />
            </div>
          </div>
          <div class="sample-content">
            {sections.map(({ title, subtitle, detail, fourth }, index) => (
              <ThemeSampleSection
                region={`section${index + 1}` as Region}
                id={`selector-section-${index + 1}`}
                label={`Section 0${index + 1}`}
                title={title}
                subtitle={subtitle}
                detail={detail}
                fourth={fourth}
                style={regionStyle(`section${index + 1}` as Region)}
              />
            ))}
          </div>
          <footer
            class="sample-footer"
            data-region="footer"
            style={regionStyle("footer")}
          >
            <ThemeSitewideBar label="Footer" className="sw-footer" />
            <div class="sample-container">
              <h2>Good things start with a little color.</h2>
              <p>Website Builder / Sample footer</p>
              <ThemeSampleSvg />
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Stay connected <ThemeSampleIcon />
                </button>
                <button type="button" class="sample-secondary">
                  Find out more <ThemeSampleIcon />
                </button>
              </div>
              <p>
                <a class="sample-inline-link" href="#selector-sample-page">
                  Back to the top <ThemeSampleIcon />
                </a>
              </p>
            </div>
          </footer>
        </div>
      </div>

      <aside
        class="selector-panel"
        aria-label="Color and theme group controls"
        data-studio-chrome
      >
        <form id="theme-group-form">
          <div class="panel-heading">
            <p class="selector-eyebrow">Your palette, your way</p>
            <h2 id="color-controls-title">Color controls</h2>
          </div>
          {roleGroups.map((group) => (
            <fieldset class="color-fields" data-control-group={group.key}>
              <legend>{group.label}</legend>
              {colorRoles
                .filter(({ group: key }) => key === group.key)
                .map(({ key, label }) => (
                  <div
                    class="color-field"
                    data-color-field={key}
                    hidden={!isColorRoleVisible("page", key)}
                    role="group"
                    aria-labelledby={`color-label-${key}`}
                  >
                    <label id={`color-label-${key}`} for={`color-${key}`}>
                      {label}
                    </label>
                    <code data-role-token={key}>
                      {semanticToken("page", key) ?? "Preview-only override"}
                    </code>
                    <span
                      class="role-swatch"
                      data-role-swatch={key}
                      aria-hidden="true"
                    ></span>
                    <select id={`color-${key}`} data-role-value={key}>
                      <option value="theme" selected>
                        Theme default
                      </option>
                      <option value="transparent">None (transparent)</option>
                      <option value="custom">Custom hex…</option>
                      <optgroup label="Neutrals">
                        {["white", "black"].map((color) => (
                          <option value={`var(--color-${color})`}>
                            {color}
                          </option>
                        ))}
                      </optgroup>
                      {pickerFamilies.map(({ key: family, label }) => (
                        <optgroup label={label} data-palette-family={family}>
                          {paletteShades.map((shade) => (
                            <option value={`var(--color-${family}-${shade})`}>
                              {family}-{shade}
                            </option>
                          ))}
                        </optgroup>
                      ))}
                    </select>
                    <input
                      type="text"
                      aria-label={`${label} hex`}
                      data-custom-role={key}
                      pattern="#[0-9a-fA-F]{6}"
                      maxlength={7}
                      placeholder="#317da6"
                      spellcheck="false"
                      hidden
                      disabled
                      required
                    />
                  </div>
                ))}
            </fieldset>
          ))}
          <div id="group-area-actions">
            <button type="button" class="control-button" id="apply-all">
              Apply this palette to all six sections
            </button>
            <p class="control-hint">
              Replaces all six section palettes with the editing area's colors.
            </p>
          </div>
          <div id="sitewide-actions" hidden>
            <p class="control-hint">
              The CTA colors, header, and footer are sitewide: not saved with a
              theme group. Save them to{" "}
              <code>src/styles/themes/sitewide.css</code>; they apply on every
              page and in Component Styling whatever theme group is used.
            </p>
            <div class="control-actions">
              <button
                type="button"
                class="control-button control-primary"
                id="save-sitewide"
                data-save-sitewide
              >
                Save to sitewide.css
              </button>
            </div>
          </div>

          <div class="saved-groups">
            <details class="saved-groups-details">
              <summary>
                <span class="saved-groups-title">Theme groups</span>
                <span class="saved-groups-current" data-current-group>
                  Unsaved palette
                </span>
              </summary>
              <div class="saved-groups-body">
                <p class="control-hint">
                  Light and dark colors, corner radii, and typography. Save
                  group also saves it to the project, so every browser sees it.
                </p>
                <label for="saved-group">Saved groups</label>
                <select id="saved-group">
                  <option value="">Unsaved palette</option>
                </select>
                <label for="group-name">Group name</label>
                <input
                  id="group-name"
                  type="text"
                  placeholder="e.g. Coastal calm"
                  maxlength={80}
                  required
                />
                <div class="control-actions">
                  <button
                    type="submit"
                    class="control-button control-primary"
                    id="save-group"
                  >
                    Save group
                  </button>
                  <button type="button" class="control-button" id="new-group">
                    Save as new
                  </button>
                  <button
                    type="button"
                    class="control-button"
                    id="delete-group"
                    disabled
                  >
                    Delete group
                  </button>
                </div>
                <div class="control-actions">
                  <button
                    type="button"
                    class="control-button"
                    id="export-groups"
                    disabled
                  >
                    Export JSON
                  </button>
                  <button
                    type="button"
                    class="control-button"
                    id="import-groups"
                  >
                    Import JSON
                  </button>
                  <input
                    id="import-file"
                    type="file"
                    accept=".json,application/json"
                    hidden
                  />
                </div>
                <div class="class-groups">
                  <h3>Classes for the page builder</h3>
                  <p class="control-hint">
                    Save group also updates this group's classes in{" "}
                    <code>src/styles/themes/groups.css</code>. Use this to
                    rewrite them without other changes.
                  </p>
                  <div class="control-actions">
                    <button
                      type="button"
                      class="control-button"
                      id="publish-group-classes"
                      disabled
                    >
                      Save classes to groups.css
                    </button>
                  </div>
                </div>
              </div>
            </details>
            <p id="selector-status" role="status" aria-live="polite"></p>
          </div>
        </form>
        <noscript>
          Enable JavaScript to edit colors and save theme groups.
        </noscript>
      </aside>
    </div>
    <details class="palette-picker" data-studio-chrome open>
      <summary>
        Style Picker <span>Show / hide</span>
      </summary>
      <div class="palette-tabs" role="tablist" aria-label="Style Picker">
        <button
          type="button"
          id="palette-color-tab"
          role="tab"
          aria-selected="true"
          aria-controls="palette-color-panel"
        >
          Color Swatches
        </button>
        <button
          type="button"
          id="palette-global-tab"
          role="tab"
          aria-selected="false"
          aria-controls="palette-global-panel"
          tabindex="-1"
        >
          Global Styles
        </button>
        <button
          type="button"
          id="palette-typography-tab"
          role="tab"
          aria-selected="false"
          aria-controls="palette-typography-panel"
          tabindex="-1"
        >
          Typography
        </button>
      </div>
      <div
        class="palette-content"
        id="palette-color-panel"
        role="tabpanel"
        aria-labelledby="palette-color-tab"
      >
        <p class="control-hint" id="theme-context"></p>
        <div class="palette-toolbar-scroll">
          <div class="palette-toolbar">
            <div class="palette-dropdowns">
              <div>
                <label for="editing-region">Editing area</label>
                <select id="editing-region">
                  <option value="global">Global (sitewide)</option>
                  {regions.map(({ key, label }) => (
                    <option value={key} selected={key === "page"}>
                      {label}
                      {sitewideAreas.some(({ region }) => region === key) &&
                        " (sitewide)"}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-target">Assign palette color to</label>
                <select id="palette-target">
                  {roleGroups.map((group) => (
                    <optgroup label={group.label} data-target-group={group.key}>
                      {colorRoles
                        .filter(({ group: key }) => key === group.key)
                        .map(({ key, label }) => (
                          <option value={key}>
                            {group.label} / {label}
                          </option>
                        ))}
                    </optgroup>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-family">Palette family</label>
                <select id="palette-family">
                  <option value="custom" disabled>
                    Custom hex / no palette family
                  </option>
                  <option value="theme" disabled>
                    Theme default / no matching palette
                  </option>
                  <option value="none" disabled>
                    None / transparent
                  </option>
                  <option value="solid">White / black</option>
                  {pickerFamilies.map(({ key, label }) => (
                    <option value={key} data-palette-family-option>
                      {label}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <div
              class="palette-swatches"
              role="group"
              aria-label="Palette shades"
            >
              {paletteShades.map((shade) => (
                <button
                  type="button"
                  data-palette-shade={shade}
                  data-palette-value={`var(--color-slate-${shade})`}
                  style={`background:var(--color-slate-${shade})`}
                  aria-label={`slate-${shade}`}
                  aria-pressed="false"
                  title={`slate-${shade}`}
                >
                  <span>{shade}</span>
                </button>
              ))}
              {["white", "black"].map((color) => (
                <button
                  type="button"
                  data-palette-solid={color}
                  data-palette-value={`var(--color-${color})`}
                  style={`background:var(--color-${color})`}
                  aria-label={color}
                  aria-pressed="false"
                  title={color}
                >
                  <span>{color}</span>
                </button>
              ))}
              <button
                type="button"
                data-palette-solid="none"
                data-palette-value="transparent"
                aria-label="None (transparent)"
                aria-pressed="false"
                title="None (transparent)"
              >
                <span>none</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        class="palette-content"
        id="palette-global-panel"
        role="tabpanel"
        aria-labelledby="palette-global-tab"
        hidden
      >
        <p class="control-hint">
          Corner radii apply across the preview in both light and dark mode.
        </p>
        <div class="palette-radius-toolbar">
          <div>
            <label for="radius-target">Edit corner radius for</label>
            <select id="radius-target">
              {radiusTargets.map(({ key, label }) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
          <div
            class="palette-radius-swatches"
            role="group"
            aria-label="Corner radius presets"
          >
            {radiusPresets.map(({ key, label, size }) => (
              <button
                type="button"
                data-radius-preset={key}
                aria-pressed="false"
                title={size}
              >
                <span aria-hidden="true" style={`border-radius:${size}`}></span>
                {label}
              </button>
            ))}
          </div>
        </div>
        <p class="control-hint" id="content-width-hint">
          Content width is the max-width of each component's content (the
          max-w-site class). Set it for the whole site, then override it for one
          area if needed.
        </p>
        <div class="palette-radius-toolbar">
          <div>
            <label for="content-width-area">Edit content width for</label>
            <select id="content-width-area">
              <option value="site">Whole site (sitewide)</option>
              {classGroupAreas.map(({ region, label }) => (
                <option value={region}>{label} (theme group)</option>
              ))}
              {sitewideAreas.map(({ region, label }) => (
                <option value={region}>{label} (sitewide)</option>
              ))}
            </select>
          </div>
          <div>
            <label for="content-width-value">Content width</label>
            <select id="content-width-value">
              <option value="">Default</option>
              {contentWidthPresets.map(({ value, label }) => (
                <option value={value}>
                  {label} / {value}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
      <div
        class="palette-content"
        id="palette-typography-panel"
        role="tabpanel"
        aria-labelledby="palette-typography-tab"
        hidden
      >
        <p class="control-hint" id="theme-typography-context">
          Typography for the page, header, hero, each section, and footer, saved
          with the theme group. Blank fields follow the site-wide defaults from
          the Typography Builder.
        </p>
        <div class="palette-typography-toolbar">
          <div>
            <label for="theme-typography-area">Area</label>
            <select id="theme-typography-area">
              {classGroupAreas.map(({ region, label }) => (
                <option value={region}>{label}</option>
              ))}
              {sitewideAreas.map(({ region, label }) => (
                <option value={region}>{label} (sitewide)</option>
              ))}
            </select>
          </div>
          <div>
            <label for="theme-typography-card">Within</label>
            <select id="theme-typography-card">
              <option value="">The whole area</option>
              {cardTargets.map(({ key, label }) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="theme-typography-element">Element</label>
            <select id="theme-typography-element">
              {typographyElements.map((element) => (
                <option value={element}>{typographyLabel(element)}</option>
              ))}
            </select>
          </div>
          {typographyProperties.map((property) => (
            <div class="theme-typography-field">
              <label for={`theme-typography-${property.key}`}>
                {property.label}
              </label>
              <select
                id={`theme-typography-${property.key}`}
                data-theme-typography={property.key}
              >
                <option value="">Default</option>
                {Object.entries(property.options ?? property.presets ?? {}).map(
                  ([value, label]) => (
                    <option value={value}>{label}</option>
                  ),
                )}
                {property.presets && <option value="custom">Custom…</option>}
              </select>
              {property.presets && (
                <input
                  type="text"
                  aria-label={`Custom ${property.label.toLowerCase()}`}
                  placeholder={property.placeholder}
                  autocomplete="off"
                  spellcheck="false"
                  data-theme-typography-custom={property.key}
                  hidden
                />
              )}
            </div>
          ))}
          <div class="theme-typography-field">
            <span class="theme-typography-spacer" aria-hidden="true"></span>
            <button
              type="button"
              class="control-button"
              id="reset-theme-typography-element"
            >
              Reset element
            </button>
          </div>
        </div>
        <div class="theme-typography-save">
          <div class="theme-typography-save-actions">
            <button
              type="button"
              class="control-button control-primary"
              id="save-theme-typography"
            >
              Save group
            </button>
            <span class="sample-sitewide-state" id="theme-typography-state">
              Saved
            </span>
          </div>
          <p class="control-hint" id="theme-typography-save-hint"></p>
          <p class="control-hint" id="theme-typography-status"></p>
        </div>
      </div>
    </details>
  </div>
</Layout>

