---
import Layout from "../../layouts/website-builder.astro";
import ThemeSampleCards from "../../components/websitebuilder/ThemeSampleCards.astro";
import ThemeSampleIcon from "../../components/websitebuilder/ThemeSampleIcon.astro";
import ThemeSampleSection from "../../components/websitebuilder/ThemeSampleSection.astro";
import css from "../../styles/themes/colors.css?raw";
import idCss from "../../styles/theme/id.css?raw";
import { builtinPaletteFamilies, readPalette } from "../../data/palette.js";
import { parseIdsFromCss } from "../../data/typography-builder.js";
import {
  colorRoles,
  defaultColorReference,
  isColorRoleVisible,
  paletteFamilies,
  paletteShades,
  radiusPresets,
  radiusTargets,
  regions,
  regionColorRoles,
  roleGroups,
  semanticToken,
  setPaletteFamilies,
  type Region,
} from "../../data/style-groups";

setPaletteFamilies(readPalette(css));
const themeIds = parseIdsFromCss(idCss);
const builtinFamilyKeys = new Set(builtinPaletteFamilies.map(({ key }) => key));
const pickerFamilies = [...paletteFamilies].sort(
  (a, b) =>
    Number(builtinFamilyKeys.has(a.key)) - Number(builtinFamilyKeys.has(b.key)),
);
const regionStyle = (region: Region) =>
  regionColorRoles
    .map(({ key }) => `--sample-${key}:${defaultColorReference(region, key)}`)
    .join(";");
const sections = [
  {
    title: "A place for your next idea",
    subtitle: "Make the first impression count",
    detail: "A little contrast goes a long way",
    fourth: "The details make it yours",
  },
  {
    title: "Find your balance",
    subtitle: "Color sets the tone",
    detail: "Keep the details in harmony",
    fourth: "A little space to breathe",
  },
  {
    title: "Better together",
    subtitle: "Four cards, one visual language",
    detail: "A collection worth exploring",
    fourth: "Every part has a place",
  },
  {
    title: "Give an idea the spotlight",
    subtitle: "One card. A clear focus.",
    detail: "Room for something special",
    fourth: "Keep the message close",
  },
  {
    title: "Two sides of the story",
    subtitle: "Build a balanced layout",
    detail: "Different perspectives, shared purpose",
    fourth: "Make space for both",
  },
  {
    title: "Bring it all together",
    subtitle: "Finish with confidence",
    detail: "Your next step starts here",
    fourth: "Ready for what comes next",
  },
];
const sampleMenu = [
  {
    label: "Discover",
    links: [
      { label: "Our ideas", section: 1 },
      { label: "Our approach", section: 2 },
    ],
  },
  {
    label: "Services",
    links: [
      { label: "What we do", section: 3 },
      { label: "In focus", section: 4 },
    ],
  },
  {
    label: "Projects",
    links: [
      { label: "Featured work", section: 4 },
      { label: "Collaborations", section: 5 },
    ],
  },
  {
    label: "About",
    links: [
      { label: "Our story", section: 5 },
      { label: "Next steps", section: 6 },
    ],
  },
];
---

<Layout
  title="Theme Builder"
  description="Explore color combinations and save reusable style groups."
>
  <div class="selector-shell" data-selector>
    <div class="selector-workspace">
      <div class="preview-column">
        <div
          class="sample-page"
          id="selector-sample-page"
          data-region="page"
          style={regionStyle("page")}
        >
          <div
            class="sample-id-bar sample-id-bar-page"
            data-section-id-control
            data-studio-chrome
          >
            <div class="sample-id-bar-info">
              <span class="sample-id-bar-dot"></span>
              <strong>Page</strong>
              <span class="sample-id-badge" id="badge-selector-sample-page">
                #selector-sample-page
              </span>
            </div>
            <div class="sample-id-bar-select-wrap">
              <label for="id-select-page">Apply CSS ID:</label>
              <select
                id="id-select-page"
                class="sample-id-select"
                data-region-target="page"
                data-default-id="selector-sample-page"
              >
                <option value="">Default (selector-sample-page)</option>
                {themeIds.map((id) => (
                  <option value={id}>#{id}</option>
                ))}
                <option value="__custom__">Custom ID...</option>
              </select>
            </div>
          </div>
          <header
            class="sample-header"
            data-region="header"
            style={regionStyle("header")}
          >
            <div class="sample-container">
              <a
                class="sample-logo"
                href="#selector-sample-page"
                aria-label="Sample Exclusive Group home"
              >
                <span class="text-brand-01">Brand01</span>
                <span class="sample-logo-group text-brand-02">Brand02</span>
              </a>
              <nav class="sample-navigation" aria-label="Sample navigation">
                <ul>
                  {sampleMenu.map(({ label, links }) => (
                    <li>
                      <details name="sample-navigation">
                        <summary>{label}</summary>
                        <ul class="sample-submenu">
                          {links.map(({ label, section }) => (
                            <li>
                              <a href={`#selector-section-${section}`}>
                                {label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </ul>
              </nav>
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Contact <ThemeSampleIcon />
                </button>
              </div>
            </div>
          </header>
          <ThemeSampleSection
            region="hero"
            id="selector-hero"
            label="Hero"
            title="Make a bold beginning"
            subtitle="A first impression with purpose"
            detail="Give your message room to shine"
            fourth="The details make it yours"
            style={regionStyle("hero")}
          />
          <div class="sample-page-intro">
            <div class="sample-container">
              <p class="sample-kicker">Page canvas</p>
              <span class="sample-heading-level">H1</span>
              <h1>A theme with purpose</h1>
              <span class="sample-heading-level">H2</span>
              <h2>Canvas, accent, and ink</h2>
              <span class="sample-heading-level">H3</span>
              <h3>A shared visual language</h3>
              <span class="sample-heading-level">H4</span>
              <h4>A detail to bring it together</h4>
              <p>
                Explore your page-level tokens here, then refine each section
                below.
              </p>
              <div class="sample-buttons">
                <button
                  type="button"
                  class="bg-cta-01 text-ink-page-dark"
                  data-cta="primary"
                >
                  CTA 01 <ThemeSampleIcon />
                </button>
                <button
                  type="button"
                  class="bg-cta-02 text-ink-inverse"
                  data-cta="secondary"
                >
                  CTA 02
                </button>
              </div>
              <p>
                <a class="sample-inline-link" href="#selector-section-1">
                  Explore the sections <ThemeSampleIcon />
                </a>
              </p>
              <ThemeSampleCards />
            </div>
          </div>
          <div class="sample-content">
            {sections.map(({ title, subtitle, detail, fourth }, index) => (
              <ThemeSampleSection
                region={`section${index + 1}` as Region}
                id={`selector-section-${index + 1}`}
                label={`Section 0${index + 1}`}
                title={title}
                subtitle={subtitle}
                detail={detail}
                fourth={fourth}
                style={regionStyle(`section${index + 1}` as Region)}
              />
            ))}
          </div>
          <footer
            class="sample-footer"
            data-region="footer"
            style={regionStyle("footer")}
          >
            <div class="sample-container">
              <h2>Good things start with a little color.</h2>
              <p>Exclusive Studio / Sample footer</p>
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Stay connected <ThemeSampleIcon />
                </button>
                <button type="button" class="sample-secondary">
                  Find out more <ThemeSampleIcon />
                </button>
              </div>
              <p>
                <a class="sample-inline-link" href="#selector-sample-page">
                  Back to the top <ThemeSampleIcon />
                </a>
              </p>
            </div>
          </footer>
        </div>
      </div>

      <aside
        class="selector-panel"
        aria-label="Color and style group controls"
        data-studio-chrome
      >
        <form id="style-group-form">
          <div class="panel-heading">
            <p class="selector-eyebrow">Your palette, your way</p>
            <h2 id="color-controls-title">Color controls / Page canvas</h2>
            <p>
              Assign palette colors to each area’s canvas, text, buttons, links,
              icons, and interactive states. Changes only affect the sample
              page.
            </p>
            <p>
              Click a heading, paragraph, button, menu item, card, or social
              icon in the preview to center and highlight its color control.
              Click the section background to edit its border.
            </p>
          </div>
          <p class="control-hint">
            Choose the editing area in the floating Color Picker. Sections 1–6
            use the first–sixth token groups. “Theme default” follows your
            existing light/dark theme. Choose Page canvas to edit page-wide
            brand and CTA colors. The interactive group includes button hover,
            focus, and active states; link, visited, hover, focus, and active
            states; and icon colors for each area.
          </p>
          {roleGroups.map((group) => (
            <fieldset class="color-fields" data-control-group={group.key}>
              <legend>{group.label}</legend>
              {colorRoles
                .filter(({ group: key }) => key === group.key)
                .map(({ key, label }) => (
                  <div
                    class="color-field"
                    data-color-field={key}
                    hidden={!isColorRoleVisible("page", key)}
                    role="group"
                    aria-labelledby={`color-label-${key}`}
                  >
                    <label id={`color-label-${key}`} for={`color-${key}`}>
                      {label}
                    </label>
                    <code data-role-token={key}>
                      {semanticToken("page", key) ?? "Preview-only override"}
                    </code>
                    <span
                      class="role-swatch"
                      data-role-swatch={key}
                      aria-hidden="true"
                    ></span>
                    <select id={`color-${key}`} data-role-value={key}>
                      <option value="theme" selected>
                        Theme default
                      </option>
                      <option value="transparent">None (transparent)</option>
                      <option value="custom">Custom hex…</option>
                      <optgroup label="Neutrals">
                        {["white", "black"].map((color) => (
                          <option value={`var(--color-${color})`}>
                            {color}
                          </option>
                        ))}
                      </optgroup>
                      {pickerFamilies.map(({ key: family, label }) => (
                        <optgroup label={label} data-palette-family={family}>
                          {paletteShades.map((shade) => (
                            <option value={`var(--color-${family}-${shade})`}>
                              {family}-{shade}
                            </option>
                          ))}
                        </optgroup>
                      ))}
                    </select>
                    <input
                      type="text"
                      aria-label={`${label} hex`}
                      data-custom-role={key}
                      pattern="#[0-9a-fA-F]{6}"
                      maxlength={7}
                      placeholder="#317da6"
                      spellcheck="false"
                      hidden
                      disabled
                      required
                    />
                  </div>
                ))}
            </fieldset>
          ))}
          <button type="button" class="control-button" id="apply-all">
            Apply this palette to all six sections
          </button>
          <p class="control-hint">
            Replaces all six section palettes with the editing area's colors.
          </p>

          <div class="saved-groups">
            <h2>Style groups</h2>
            <p class="control-hint">
              A group saves light and dark colors for each area and global
              corner radii shared by both themes. Stored in this browser; export
              a backup to reuse elsewhere.
            </p>
            <label for="saved-group">Saved groups</label>
            <select id="saved-group">
              <option value="">Unsaved palette</option>
            </select>
            <label for="group-name">Group name</label>
            <input
              id="group-name"
              type="text"
              placeholder="e.g. Coastal calm"
              maxlength={80}
              required
            />
            <div class="control-actions">
              <button
                type="submit"
                class="control-button control-primary"
                id="save-group"
              >
                Save group
              </button>
              <button type="button" class="control-button" id="new-group">
                Save as new
              </button>
              <button
                type="button"
                class="control-button"
                id="delete-group"
                disabled
              >
                Delete group
              </button>
            </div>
            <div class="control-actions">
              <button
                type="button"
                class="control-button"
                id="export-groups"
                disabled
              >
                Export JSON
              </button>
              <button type="button" class="control-button" id="import-groups">
                Import JSON
              </button>
              <input
                id="import-file"
                type="file"
                accept=".json,application/json"
                hidden
              />
            </div>
            <p id="selector-status" role="status" aria-live="polite"></p>
          </div>
        </form>
        <noscript>
          Enable JavaScript to edit colors and save style groups.
        </noscript>
      </aside>
    </div>
    <details class="palette-picker" data-studio-chrome open>
      <summary>
        Color Picker <span>Show / hide</span>
      </summary>
      <div class="palette-tabs" role="tablist" aria-label="Color Picker">
        <button
          type="button"
          id="palette-color-tab"
          role="tab"
          aria-selected="true"
          aria-controls="palette-color-panel"
        >
          Color Swatches
        </button>
        <button
          type="button"
          id="palette-global-tab"
          role="tab"
          aria-selected="false"
          aria-controls="palette-global-panel"
          tabindex="-1"
        >
          Global Styles
        </button>
      </div>
      <div
        class="palette-content"
        id="palette-color-panel"
        role="tabpanel"
        aria-labelledby="palette-color-tab"
      >
        <p class="control-hint" id="theme-context"></p>
        <div class="palette-toolbar-scroll">
          <div class="palette-toolbar">
            <div class="palette-dropdowns">
              <div>
                <label for="editing-region">Editing area</label>
                <select id="editing-region">
                  {regions.map(({ key, label }) => (
                    <option value={key}>{label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-target">Assign palette color to</label>
                <select id="palette-target">
                  {roleGroups.map((group) => (
                    <optgroup label={group.label} data-target-group={group.key}>
                      {colorRoles
                        .filter(({ group: key }) => key === group.key)
                        .map(({ key, label }) => (
                          <option value={key}>
                            {group.label} / {label}
                          </option>
                        ))}
                    </optgroup>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-family">Palette family</label>
                <select id="palette-family">
                  <option value="custom" disabled>
                    Custom hex / no palette family
                  </option>
                  <option value="theme" disabled>
                    Theme default / no matching palette
                  </option>
                  <option value="none" disabled>
                    None / transparent
                  </option>
                  <option value="solid">White / black</option>
                  {pickerFamilies.map(({ key, label }) => (
                    <option value={key} data-palette-family-option>
                      {label}
                    </option>
                  ))}
                </select>
              </div>
            </div>
            <div
              class="palette-swatches"
              role="group"
              aria-label="Palette shades"
            >
              {paletteShades.map((shade) => (
                <button
                  type="button"
                  data-palette-shade={shade}
                  data-palette-value={`var(--color-slate-${shade})`}
                  style={`background:var(--color-slate-${shade})`}
                  aria-label={`slate-${shade}`}
                  aria-pressed="false"
                  title={`slate-${shade}`}
                >
                  <span>{shade}</span>
                </button>
              ))}
              {["white", "black"].map((color) => (
                <button
                  type="button"
                  data-palette-solid={color}
                  data-palette-value={`var(--color-${color})`}
                  style={`background:var(--color-${color})`}
                  aria-label={color}
                  aria-pressed="false"
                  title={color}
                >
                  <span>{color}</span>
                </button>
              ))}
              <button
                type="button"
                data-palette-solid="none"
                data-palette-value="transparent"
                aria-label="None (transparent)"
                aria-pressed="false"
                title="None (transparent)"
              >
                <span>none</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        class="palette-content"
        id="palette-global-panel"
        role="tabpanel"
        aria-labelledby="palette-global-tab"
        hidden
      >
        <p class="control-hint">
          Corner radii apply across the preview in both light and dark mode.
        </p>
        <div class="palette-radius-toolbar">
          <div>
            <label for="radius-target">Edit corner radius for</label>
            <select id="radius-target">
              {radiusTargets.map(({ key, label }) => (
                <option value={key}>{label}</option>
              ))}
            </select>
          </div>
          <div
            class="palette-radius-swatches"
            role="group"
            aria-label="Corner radius presets"
          >
            {radiusPresets.map(({ key, label, size }) => (
              <button
                type="button"
                data-radius-preset={key}
                aria-pressed="false"
                title={size}
              >
                <span aria-hidden="true" style={`border-radius:${size}`}></span>
                {label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </details>
  </div>
</Layout>

<script>
  import "../../scripts/websitebuilder/style-selector";
</script>
