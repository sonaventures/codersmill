---
import Layout from "../../../../layouts/layout.astro";
import {
  blocks,
  type BlockEntry,
} from "../../../../data/website-builder/display-blocks";

// One block on its own page, wrapped as the Page Builder wraps it: a page
// class around a <section> with an area class. A header or footer can also
// take its sitewide styles (sw-header / sw-footer), as on the site. Display
// Blocks shows it in an iframe and tells it which theme group, area, and
// light / dark mode to use.
export function getStaticPaths() {
  return blocks.map((block) => ({ params: { block: block.id }, props: block }));
}

const { id, slot, load } = Astro.props as BlockEntry;
const { default: Block } = await load();
---

<Layout
  title={`Block: ${id}`}
  description={`A preview of the ${id} block.`}
  showHeader={false}
  showFooter={false}
>
  <div data-display-page>
    {slot ? (
      <div
        data-display-section
        data-display-slot={slot}
        data-display-block={id}
      >
        <Block />
      </div>
    ) : (
      <section data-display-section data-display-block={id}>
        <Block />
      </section>
    )}
  </div>
</Layout>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const savedTheme = root.dataset.theme;
    const page = document.querySelector("[data-display-page]");
    const section = document.querySelector("[data-display-section]");
    const groupPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
    const areaPattern = /^(?:hero|section-[1-6])$/;
    // A header or footer block, which can take its sitewide styles.
    const slot = section?.dataset.displaySlot;
    function apply({ group = "", area = "section-1", theme = "" }) {
      const sitewide = Boolean(slot) && area === "sitewide";
      const valid =
        !sitewide && groupPattern.test(group) && areaPattern.test(area);
      if (page) page.className = valid ? `sg-${group}-page` : "";
      if (section)
        section.className = sitewide
          ? `sw-${slot}`
          : valid
            ? `sg-${group}-${area}`
            : "";
      const mode = theme === "light" || theme === "dark" ? theme : savedTheme;
      if (mode) {
        root.dataset.theme = mode;
        root.style.colorScheme = mode;
      }
    }
    // In Display Blocks, leave room to scroll the block's end above the
    // floating palette.
    if (window.parent !== window) document.body.style.paddingBottom = "12rem";
    const params = new URLSearchParams(location.search);
    apply({
      group: params.get("group") ?? "",
      area: params.get("area") ?? "section-1",
      theme: params.get("theme") ?? "",
    });
    window.addEventListener("message", (event) => {
      if (
        event.origin === location.origin &&
        event.data?.source === "display-blocks"
      )
        apply(event.data);
    });
  })();
</script>
