---
import Layout from "../../layouts/layout.astro";
import "../../styles/websitebuilder/websitebuilder.css";
import ColorEditorGuide from "../../components/websitebuilder/guides/ColorEditorGuide.astro";
import ThemeColorControlsGuide from "../../components/websitebuilder/guides/ThemeColorControlsGuide.astro";
import TypographyGuide from "../../components/websitebuilder/guides/TypographyGuide.astro";

// Build theme groups before pages: the page builder assigns the classes the
// theme builder saves to the page and its components. A step's guide is
// shown under it, closed until opened.
const steps: {
  label: string;
  slug: string;
  guide?: { label: string; component: typeof ColorEditorGuide };
}[] = [
  {
    label: "Add custom colors",
    slug: "custom-colors",
    guide: { label: "Color editor guide", component: ColorEditorGuide },
  },
  { label: "Add custom fonts", slug: "custom-fonts" },
  {
    label: "Create theme groups (Theme Builder)",
    slug: "theme-builder",
    guide: {
      label: "How to use color controls",
      component: ThemeColorControlsGuide,
    },
  },
  {
    label: "Typography Builder",
    slug: "typography-builder",
    guide: { label: "Typography guide", component: TypographyGuide },
  },
  {
    label: "Create a page and assign theme groups",
    slug: "page-builder",
  },
  {
    label: "Style components (buttons, links, cards)",
    slug: "component-styling",
  },
  { label: "Site Nav Builder", slug: "sitenav-builder" },
];
const toolPath = (slug: string) => `/website-builder/${slug}/`;
const initialPath = toolPath(steps[0].slug);
---

<Layout
  siteName="Website Builder"
  description="Follow the guide to build and style your website."
  showHeader={false}
  showFooter={false}
>
  <div class="builder-workspace" data-website-builder-content>
    <aside
      id="builder-workspace-guide"
      class="builder-workspace-guide"
      aria-labelledby="builder-guide-title"
      tabindex="0"
    >
      <h1 id="builder-guide-title" class="text-lg font-bold">
        Builder guide
      </h1>
      <nav aria-labelledby="builder-guide-title">
        <ol class="my-4 grid list-decimal gap-2 ps-6">
          {steps.map(({ label, slug, guide }, index) => (
            <li>
              <a
                class="builder-workspace-link"
                href={`${toolPath(slug)}?workspace=1`}
                target="builder-tool"
                aria-current={index === 0 ? "step" : undefined}
                data-tool={slug}
              >
                {label}
              </a>
              {guide && (
                <details class="builder-step-guide">
                  <summary>{guide.label}</summary>
                  <div class="builder-step-guide-body">
                    <guide.component />
                  </div>
                </details>
              )}
            </li>
          ))}
        </ol>
        <a
          class="builder-workspace-link"
          href={`${toolPath("form-builder")}?workspace=1`}
          target="builder-tool"
          data-tool="form-builder"
        >
          Form Builder <span class="text-sm">(optional)</span>
        </a>
      </nav>

      <div class="mt-5 grid justify-items-start gap-2 border-t border-canvas-page-border pt-4">
        <button
          type="button"
          class="btn btn-outline"
          id="builder-workspace-theme"
        >
          Switch theme
        </button>
        <h2 class="font-semibold">Builder color palettes</h2>
        <button
          type="button"
          class="btn btn-outline"
          id="reset-builder-palette"
        >
          Reset to Tailwind colors
        </button>
        <button
          type="button"
          class="btn btn-outline"
          id="restore-builder-palette"
        >
          Show custom colors
        </button>
        <p id="builder-palette-status" class="text-sm" role="status"></p>
      </div>
    </aside>

    <div
      class="builder-workspace-resize"
      id="builder-workspace-resize"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize the builder guide"
      aria-controls="builder-workspace-guide"
      title="Drag to resize the builder guide. Double-click to reset."
      tabindex="0"
    >
    </div>

    <section class="builder-workspace-tool" aria-label="Selected builder">
      <a
        id="open-full-builder"
        class="builder-workspace-full-link"
        href={initialPath}
        target="_blank"
        rel="noopener"
      >
        Open tool in a new tab
      </a>
      <iframe
        id="builder-tool"
        name="builder-tool"
        title={steps[0].label}
        src={`${initialPath}?workspace=1`}
      ></iframe>
    </section>
  </div>
</Layout>

<script>
  import {
    setTailwindPaletteOnly,
    usesTailwindPaletteOnly,
  } from "../../scripts/websitebuilder/palette-preference";

  const tool = document.querySelector<HTMLIFrameElement>("#builder-tool");
  const fullPage =
    document.querySelector<HTMLAnchorElement>("#open-full-builder");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-tool]");
  const themeToggle = document.querySelector<HTMLButtonElement>(
    "#builder-workspace-theme",
  );
  const status = document.querySelector("#builder-palette-status");
  const reset = document.querySelector("#reset-builder-palette");
  const restore = document.querySelector("#restore-builder-palette");
  const themeKey = "exclusive-group-theme";

  function applyTheme(doc: Document, theme: "light" | "dark") {
    doc.documentElement.dataset.theme = theme;
    doc.documentElement.style.colorScheme = theme;
    const color = getComputedStyle(doc.documentElement)
      .getPropertyValue("--canvas-page")
      .trim();
    if (color)
      doc
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", color);
  }

  function syncTheme() {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    const toolDocument = tool?.contentDocument;
    if (toolDocument?.documentElement.hasAttribute("data-builder-embedded"))
      applyTheme(toolDocument, theme);
    if (themeToggle)
      themeToggle.textContent = `Switch to ${theme === "dark" ? "light" : "dark"} theme`;
  }

  function syncTool() {
    const path = tool?.contentDocument?.location.pathname.replace(/\/?$/, "/");
    if (!tool || !path) return;
    for (const link of links) {
      if (new URL(link.href).pathname !== path) {
        link.removeAttribute("aria-current");
        continue;
      }
      link.setAttribute("aria-current", "step");
      tool.title = link.textContent?.trim() || "Builder tool";
      if (fullPage) fullPage.href = path;
    }
    syncTheme();
  }

  tool?.addEventListener("load", syncTool);
  syncTool();
  syncTheme();
  themeToggle?.addEventListener("click", () => {
    const theme =
      document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(document, theme);
    syncTheme();
    try {
      localStorage.setItem(themeKey, theme);
    } catch (error) {
      console.warn("Unable to save the theme preference.", error);
    }
  });

  function showPalettePreference() {
    if (!status) return;
    status.textContent = usesTailwindPaletteOnly()
      ? "Pickers show Tailwind defaults only. Custom colors are not deleted."
      : "Pickers show Tailwind and custom families.";
  }

  function updatePalettePreference(tailwindOnly: boolean) {
    try {
      setTailwindPaletteOnly(tailwindOnly);
      showPalettePreference();
      const path = tool?.contentDocument?.location.pathname;
      if (status && path && /\/(?:theme|form|sitenav)-builder\/?$/.test(path)) {
        status.append(" Reopen the current tool to apply this setting.");
      }
    } catch (error) {
      console.error("Unable to save the builder palette preference:", error);
      if (status)
        status.textContent =
          "Could not save your palette preference. Check your browser storage settings.";
    }
  }

  // The builder guide's width: drag the handle between the guide and the
  // tool, or focus it and use the arrow keys (Shift for bigger steps), Home
  // and End. Double-click resets it. The width is remembered in this browser.
  const workspace = document.querySelector<HTMLElement>(".builder-workspace");
  const guide = document.querySelector<HTMLElement>("#builder-workspace-guide");
  const handle = document.querySelector<HTMLElement>("#builder-workspace-resize");
  const widthKey = "website-builder-guide-width";
  const minWidth = 192;
  // Keep at least this much room for the tool.
  const toolRoom = 320;

  function widthLimits() {
    const total = workspace?.clientWidth ?? window.innerWidth;
    return { min: minWidth, max: Math.max(minWidth, total - toolRoom) };
  }

  function setGuideWidth(width: number | null, save = true) {
    if (!workspace || !handle || !guide) return;
    if (width === null) {
      workspace.style.removeProperty("--guide-width");
      if (save)
        try {
          localStorage.removeItem(widthKey);
        } catch {}
    } else {
      const { min, max } = widthLimits();
      const clamped = Math.round(Math.min(max, Math.max(min, width)));
      workspace.style.setProperty("--guide-width", `${clamped}px`);
      if (save)
        try {
          localStorage.setItem(widthKey, String(clamped));
        } catch {}
    }
    const { min, max } = widthLimits();
    handle.setAttribute("aria-valuemin", String(min));
    handle.setAttribute("aria-valuemax", String(max));
    handle.setAttribute(
      "aria-valuenow",
      String(Math.round(guide.getBoundingClientRect().width)),
    );
  }

  if (workspace && guide && handle) {
    let saved: number | null = null;
    try {
      const value = Number(localStorage.getItem(widthKey));
      if (Number.isFinite(value) && value > 0) saved = value;
    } catch {}
    setGuideWidth(saved, false);

    let dragging = false;
    handle.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      dragging = true;
      handle.setPointerCapture(event.pointerId);
      // The tool's iframe would swallow the pointer while dragging over it.
      workspace.dataset.resizing = "";
      event.preventDefault();
    });
    handle.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      setGuideWidth(event.clientX - guide.getBoundingClientRect().left);
    });
    const stop = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      delete workspace.dataset.resizing;
      if (handle.hasPointerCapture(event.pointerId))
        handle.releasePointerCapture(event.pointerId);
    };
    handle.addEventListener("pointerup", stop);
    handle.addEventListener("pointercancel", stop);
    handle.addEventListener("dblclick", () => setGuideWidth(null));
    handle.addEventListener("keydown", (event) => {
      const current = guide.getBoundingClientRect().width;
      const step = event.shiftKey ? 64 : 16;
      const { min, max } = widthLimits();
      const next =
        event.key === "ArrowLeft"
          ? current - step
          : event.key === "ArrowRight"
            ? current + step
            : event.key === "Home"
              ? min
              : event.key === "End"
                ? max
                : null;
      if (next === null) return;
      event.preventDefault();
      setGuideWidth(next);
    });
    // Keep a saved width within the window when it is resized.
    window.addEventListener("resize", () => {
      const width = workspace.style.getPropertyValue("--guide-width");
      setGuideWidth(width ? parseFloat(width) : null, false);
    });
  }

  showPalettePreference();
  reset?.addEventListener("click", () => updatePalettePreference(true));
  restore?.addEventListener("click", () => updatePalettePreference(false));
</script>
