---
import PageIntro from "../components/PageIntro.astro";
import Layout from "../layouts/layout.astro";
import { builderPages } from "../data/website-builder";
import { pageDescriptions, siteName } from "../data/site";

const tools = builderPages.filter(({ label }) => label !== "Home");
---

<Layout title="Tools" description={pageDescriptions.tools}>
  <PageIntro
    eyebrow="Tools"
    title={`The ${siteName} tools`}
    description="Each tool handles one part of the site, from the color palette to the finished pages. They are listed in the order you use them."
  />

  <section class="container content-section" aria-labelledby="tools-title">
    <div class="section-heading section-heading-inline">
      <div>
        <p class="eyebrow">In workflow order</p>
        <h2 id="tools-title">Every tool</h2>
      </div>
      <p>{tools.length} tools</p>
    </div>
    <ul class="company-grid">
      {tools.map(({ label, href, description }, index) => (
        <li class="company-card">
          <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
          <h3>{label}</h3>
          <p>{description}</p>
          <a class="text-link" href={href}>
            Open {label} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
