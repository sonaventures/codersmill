---
import PageIntro from "../components/PageIntro.astro";
import Layout from "../layouts/layout.astro";
import { companies, pageDescriptions } from "../data/group";
---

<Layout title="Companies" description={pageDescriptions.companies}>
  <PageIntro
    eyebrow="Directory"
    title="Companies"
    description="The company names below are the current directory entries. Website destinations can be added when they are provided."
  />

  <section class="container content-section" aria-labelledby="companies-title">
    <div class="section-heading section-heading-inline">
      <div>
        <p class="eyebrow">Listed companies</p>
        <h2 id="companies-title">The directory</h2>
      </div>
      <p>{companies.length} companies listed</p>
    </div>
    <ul class="company-grid">
      {companies.map(({ name, websiteUrl }, index) => (
        <li class="company-card">
          <span class="card-index">0{index + 1}</span>
          <h3>{name}</h3>
          {websiteUrl ? (
            <a class="text-link" href={websiteUrl}>
              Visit company website <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <p class="pending-label">
              <span aria-hidden="true">•</span> Website destination pending
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>
</Layout>
