---
import { decodeSlug, getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Layout from "../../../layouts/layout.astro";
import { blogPath, formatDate } from "../../../data/blog";

// One post, read from EmDash on each request.
export const prerender = false;

const slug = decodeSlug(Astro.params.slug);
const { entry: post, cacheHint } = slug
  ? await getEmDashEntry("posts", slug)
  : { entry: null, cacheHint: undefined };
if (!post) return new Response(null, { status: 404, statusText: "Not found" });
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const { title, excerpt, content, featured_image, publishedAt, updatedAt } =
  post.data;
const authors = (post.data.bylines ?? []).map(
  ({ byline }) => byline.displayName,
);
const tags = post.data.terms?.tag ?? [];
const updated =
  publishedAt && updatedAt.valueOf() - publishedAt.valueOf() > 86_400_000
    ? updatedAt
    : null;
---

<Layout title={title} description={excerpt ?? title}>
  <article class="container content-section">
    <div class="blog-post">
      <header class="blog-post-header">
        <p class="eyebrow">
          <a href={blogPath}>Blog</a>
        </p>
        <h1>{title}</h1>
        <p class="blog-post-meta">
          {authors.length > 0 && <>By {authors.join(", ")}</>}
          {publishedAt && (
            <>
              {authors.length > 0 && " · "}
              <time datetime={publishedAt.toISOString()}>
                {formatDate(publishedAt)}
              </time>
            </>
          )}
          {updated && (
            <>
              {" "}
              · Updated{" "}
              <time datetime={updated.toISOString()}>
                {formatDate(updated)}
              </time>
            </>
          )}
        </p>
        {tags.length > 0 && (
          <ul class="blog-post-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag.label}</li>
            ))}
          </ul>
        )}
      </header>
      {featured_image && (
        <div class="blog-post-image">
          <Image
            image={featured_image}
            sizes="(min-width: 720px) 720px, 92vw"
            priority
          />
        </div>
      )}
      <div class="blog-post-body">
        {content && <PortableText value={content} />}
      </div>
      <p class="blog-post-back">
        <a class="text-link" href={blogPath}>
          <span aria-hidden="true">←</span> All posts
        </a>
      </p>
    </div>
  </article>
</Layout>
