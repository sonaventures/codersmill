---
import { render } from "astro:content";
import Layout from "../../../layouts/layout.astro";
import { blogPath, formatDate, getPosts, type Post } from "../../../data/blog";

// One blog post, from src/content/blog/<slug>.md or .mdx.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, tags } = post.data;
---

<Layout title={title} description={description}>
  <article class="container content-section">
    <div class="blog-post">
      <header class="blog-post-header">
        <p class="eyebrow">
          <a href={blogPath}>Blog</a>
        </p>
        <h1>{title}</h1>
        <p class="blog-post-meta">
          By {author} ·{" "}
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              {" "}
              · Updated{" "}
              <time datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate)}
              </time>
            </>
          )}
        </p>
        {tags.length > 0 && (
          <ul class="blog-post-tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
      </header>
      <div class="blog-post-body">
        <Content />
      </div>
      <p class="blog-post-back">
        <a class="text-link" href={blogPath}>
          <span aria-hidden="true">←</span> All posts
        </a>
      </p>
    </div>
  </article>
</Layout>
