---
import FpHero from "../../components/fp_hero.astro";
import Layout from "../../layouts/layout.astro";
import { builderName, host, pageDescriptions, siteName } from "../../data/site";
---

<Layout title="Who we are" description={pageDescriptions.about}>
  <FpHero
    eyebrow="Us"
    title={siteName}
    description={`${siteName} is the home of ${builderName}, a set of browser tools for building and styling Astro websites.`}
  />

  <section class="container content-section about-copy">
    <p class="eyebrow">How it works</p>
    <h2>Your design, saved to your project.</h2>
    <p>
      Start with your colors, then group them into themes for each part of a
      page: the page itself, the hero, and each section. Set the typography,
      assemble pages from ready-made blocks, and give their buttons, links,
      icons, and cards your theme's styles. The tools write plain CSS and Astro
      files into your project, so the site you build is yours to keep.
    </p>
    <p class="eyebrow">Hosting</p>
    <p>
      {builderName} is hosted by{" "}
      <a class="text-link" href={host.url}>
        {host.name} <span aria-hidden="true">↗</span>
      </a>
    </p>
    <a class="text-link" href="/website-builder/">
      Open the builder <span aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
