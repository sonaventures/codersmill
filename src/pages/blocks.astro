---
import PageIntro from "../components/PageIntro.astro";
import Layout from "../layouts/layout.astro";
import { pageDescriptions } from "../data/site";

// The block libraries in src/components/blocks, counted from the files (empty
// placeholders left out), so the page stays current as blocks change.
const sources: Record<string, string> = import.meta.glob(
  "../components/blocks/**/*.astro",
  { query: "?raw", import: "default", eager: true },
);
const files = Object.entries(sources)
  .filter(([, source]) => source.trim())
  .map(([path]) => path.replace("../components/blocks/", "").split("/"));
const names: Record<string, string> = {
  codersmill: "Coders Mill",
  flowbite: "Flowbite",
  flyonui: "FlyonUI",
};
const libraries = [...new Set(files.map(([library]) => library))]
  .sort()
  .map((library) => {
    const blocks = files.filter(([name]) => name === library);
    const kinds = [...new Set(blocks.map(([, kind]) => kind))].sort();
    return {
      name: names[library] ?? library,
      folder: `src/components/blocks/${library}/`,
      count: blocks.length,
      kinds,
    };
  });
---

<Layout title="Blocks" description={pageDescriptions.blocks}>
  <PageIntro
    eyebrow="Blocks"
    title="Pages are built from blocks"
    description="A block is a ready-made piece of HTML, such as a hero, a call to action, or a set of testimonials. The Page Builder stacks blocks into a page, and your theme groups color them."
  />

  <section class="container content-section" aria-labelledby="blocks-title">
    <div class="section-heading section-heading-inline">
      <div>
        <p class="eyebrow">Block libraries</p>
        <h2 id="blocks-title">What is available</h2>
      </div>
      <p>
        {libraries.reduce((total, { count }) => total + count, 0)} blocks
      </p>
    </div>
    <ul class="company-grid">
      {libraries.map(({ name, folder, count, kinds }) => (
        <li class="company-card">
          <span class="card-index">
            {count} {count === 1 ? "block" : "blocks"}
          </span>
          <h3>{name}</h3>
          <p>{kinds.join(", ")}</p>
          <p class="pending-label">
            <code>{folder}</code>
          </p>
        </li>
      ))}
    </ul>
  </section>
</Layout>
