---
import Layout from "../layouts/layout.astro";
import { pageDescriptions } from "../data/site";
import Component1 from "../components/codersmill/fp_hero-5.astro";
import Component2 from "../components/codersmill/fp_portfolio-1.astro";
import Component3 from "../components/codersmill/fp_cta-5.astro";
import Component4 from "../components/codersmill/fp_features-3.astro";
import Component5 from "../components/codersmill/fp_cta-7.astro";
---

<Layout description={pageDescriptions.home}>
  <div class="sg-codersmill-page">
    <section id="fp_hero-5" class="sg-codersmill-hero">
      <Component1 />
    </section>
    <section id="fp_portfolio-1" class="sg-codersmill-section-1">
      <Component2 />
    </section>
    <section id="fp_cta-5" class="sg-codersmill-section-2">
      <Component3 />
    </section>
    <section id="fp_features-3" class="sg-codersmill-section-3">
      <Component4 />
    </section>
    <section id="fp_cta-7" class="sg-codersmill-section-4">
      <Component5 />
    </section>
  </div>
</Layout>
