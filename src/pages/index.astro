---
import FpHero from "../components/fp_hero.astro";
import Layout from "../layouts/layout.astro";
import { builderPages } from "../data/website-builder";
import { host, pageDescriptions, siteName } from "../data/site";

// The builder's tools, in workflow order (its home page is the builder).
const tools = builderPages.filter(({ label }) => label !== "Home");
---

<Layout description={pageDescriptions.home}>
  <FpHero
    eyebrow={siteName}
    title="Build and style a website from blocks."
    description="Pick colors, group them into themes, set the typography, then assemble pages from ready-made blocks and give them your theme. Everything is saved to your Astro project."
  />

  <section class="container home-overview" aria-labelledby="overview-title">
    <div class="section-heading">
      <p class="eyebrow">The workflow</p>
      <h2 id="overview-title">One tool for each step</h2>
      <p>
        Work through the tools in order, or open any of them on its own. Each
        one saves its part of the site to your project.
      </p>
    </div>
    <div class="section-link-grid">
      {tools.map(({ label, href }, index) => (
        <a class="section-link-card" href={href}>
          <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
          <span class="card-title">{label}</span>
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-note">
    <div class="container home-note-inner">
      <p class="eyebrow">Hosted by {host.name}</p>
      <p>
        {siteName} is hosted by {host.name}. Open the builder to start a site,
        or read more about how it works.
      </p>
      <a class="text-link" href="/about/">
        About {siteName} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
