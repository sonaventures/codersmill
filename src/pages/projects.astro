---
import PageIntro from "../components/PageIntro.astro";
import Layout from "../layouts/layout.astro";
import { pageDescriptions, projects } from "../data/group";
---

<Layout title="Projects" description={pageDescriptions.projects}>
  <PageIntro
    eyebrow="Work"
    title="Projects"
    description="Project stories will appear here when details and supporting materials are available."
  />

  <section class="container content-section" aria-labelledby="projects-title">
    {projects.length > 0 ? (
      <div class="company-grid">
        {projects.map(({ title, summary, imageUrl }) => (
          <article class="company-card">
            <span class="card-index">Project</span>
            {imageUrl && (
              <img
                class="project-image"
                src={imageUrl}
                alt={title}
                loading="lazy"
              />
            )}
            <h2>{title}</h2>
            <p>{summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-state-mark" aria-hidden="true">
          —
        </span>
        <p class="eyebrow">Project showcase</p>
        <h2 id="projects-title">No projects published yet</h2>
        <p>
          Project details, images, and descriptions have not been supplied. This
          section will remain open for verified content.
        </p>
      </div>
    )}
  </section>
</Layout>
