---
import Layout from "../../layouts/layout.astro";
import StudioHeader from "../../components/StudioHeader.astro";
import ThemeSampleCards from "../../components/ThemeSampleCards.astro";
import css from "../../styles/themes/colors.css?raw";
import { readPalette } from "../../data/palette.js";
import {
  colorRoles,
  defaultColorReference,
  isColorRoleVisible,
  paletteColors,
  paletteFamilies,
  paletteShades,
  regions,
  regionColorRoles,
  roleGroups,
  semanticToken,
  setPaletteFamilies,
  type Region,
} from "../../data/style-groups";

setPaletteFamilies(readPalette(css));
const regionStyle = (region: Region) =>
  regionColorRoles
    .map(({ key }) => `--sample-${key}:${defaultColorReference(region, key)}`)
    .join(";");
const sections = [
  {
    title: "A place for your next idea",
    subtitle: "Make the first impression count",
    detail: "A little contrast goes a long way",
  },
  {
    title: "Find your balance",
    subtitle: "Color sets the tone",
    detail: "Keep the details in harmony",
  },
  {
    title: "Better together",
    subtitle: "Four cards, one visual language",
    detail: "A collection worth exploring",
  },
  {
    title: "Give an idea the spotlight",
    subtitle: "One card. A clear focus.",
    detail: "Room for something special",
  },
  {
    title: "Two sides of the story",
    subtitle: "Build a balanced layout",
    detail: "Different perspectives, shared purpose",
  },
  {
    title: "Bring it all together",
    subtitle: "Finish with confidence",
    detail: "Your next step starts here",
  },
];
const sampleMenu = [
  {
    label: "Discover",
    links: [
      { label: "Our ideas", section: 1 },
      { label: "Our approach", section: 2 },
    ],
  },
  {
    label: "Services",
    links: [
      { label: "What we do", section: 3 },
      { label: "In focus", section: 4 },
    ],
  },
  {
    label: "Projects",
    links: [
      { label: "Featured work", section: 4 },
      { label: "Collaborations", section: 5 },
    ],
  },
  {
    label: "About",
    links: [
      { label: "Our story", section: 5 },
      { label: "Next steps", section: 6 },
    ],
  },
];
---

<Layout
  title="Theme Maker"
  description="Explore color combinations and save reusable style groups."
>
  <StudioHeader
    slot="header"
    title="Theme Maker"
    description="Find a combination that feels right. Preview it, save it, use it again."
    otherHref="/template/colors/"
    otherLabel="Color editor"
    constrainWidth={true}
    linksRight={true}
  />
  <div class="selector-shell" data-selector>
    <div class="selector-workspace">
      <div class="preview-column">
        <div
          class="sample-page"
          id="selector-sample-page"
          data-region="page"
          style={regionStyle("page")}
        >
          <header
            class="sample-header"
            data-region="header"
            style={regionStyle("header")}
          >
            <div class="sample-container">
              <a
                class="sample-logo"
                href="#selector-sample-page"
                aria-label="Sample Exclusive Group home"
              >
                <span class="text-brand-01">Brand01</span>
                <span class="sample-logo-group text-brand-02">Brand02</span>
              </a>
              <nav class="sample-navigation" aria-label="Sample navigation">
                <ul>
                  {sampleMenu.map(({ label, links }) => (
                    <li>
                      <details name="sample-navigation">
                        <summary>{label}</summary>
                        <ul class="sample-submenu">
                          {links.map(({ label, section }) => (
                            <li>
                              <a href={`#selector-section-${section}`}>
                                {label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </header>
          <section
            class="sample-page-intro"
            id="selector-hero"
            data-region="hero"
            style={regionStyle("hero")}
          >
            <div class="sample-container">
              <p class="sample-kicker">Hero</p>
              <h1>Make a bold beginning</h1>
              <h2>A first impression with purpose</h2>
              <h3>Give your message room to shine</h3>
              <p>
                Explore a hero canvas with its own headings, text, and accents,
                independently of the page canvas.
              </p>
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Get started
                </button>
                <button type="button" class="sample-secondary">
                  Learn more
                </button>
              </div>
            </div>
          </section>
          <div class="sample-page-intro">
            <div class="sample-container">
              <p class="sample-kicker">Page canvas</p>
              <h1>A theme with purpose</h1>
              <h2>Canvas, accent, and ink</h2>
              <h3>A shared visual language</h3>
              <p>
                Explore your page-level tokens here, then refine each section
                below.
              </p>
              <div class="sample-buttons">
                <button
                  type="button"
                  class="bg-cta-01 text-ink-page-dark"
                  data-cta="primary"
                >
                  CTA 01
                </button>
                <button
                  type="button"
                  class="bg-cta-02 text-ink-inverse"
                  data-cta="secondary"
                >
                  CTA 02
                </button>
              </div>
              <ThemeSampleCards />
            </div>
          </div>
          <div class="sample-content">
            {sections.map(({ title, subtitle, detail }, index) => (
              <section
                class="sample-section"
                id={`selector-section-${index + 1}`}
                data-region={`section${index + 1}`}
                style={regionStyle(`section${index + 1}` as Region)}
              >
                <div class="sample-container">
                  <p class="sample-kicker">Section 0{index + 1}</p>
                  <h1>{title}</h1>
                  <h2>{subtitle}</h2>
                  <h3>{detail}</h3>
                  <p class="sample-copy">
                    Thoughtful color brings a page to life. Explore how
                    backgrounds, headings, text, and small details work together
                    to create a welcoming, readable experience.
                  </p>
                  <div class="sample-buttons">
                    <button type="button" class="sample-primary">
                      Primary action
                    </button>
                    <button type="button" class="sample-secondary">
                      Secondary action
                    </button>
                  </div>
                  <ThemeSampleCards />
                  {index === 4 && (
                    <div class="sample-two-columns">
                      <div>
                        <h3>Space to imagine</h3>
                        <p>
                          Use this column to see how text and headings sit
                          together against your chosen background.
                        </p>
                      </div>
                      <div>
                        <h3>Space to make it real</h3>
                        <p>
                          A second column helps you compare the rhythm and
                          readability of longer content side by side.
                        </p>
                      </div>
                    </div>
                  )}
                </div>
              </section>
            ))}
          </div>
          <footer
            class="sample-footer"
            data-region="footer"
            style={regionStyle("footer")}
          >
            <div class="sample-container">
              <h2>Good things start with a little color.</h2>
              <p>Exclusive Studio / Sample footer</p>
              <div class="sample-buttons">
                <button type="button" class="sample-primary">
                  Stay connected
                </button>
                <button type="button" class="sample-secondary">
                  Find out more
                </button>
              </div>
            </div>
          </footer>
        </div>
      </div>

      <aside
        class="selector-panel"
        aria-label="Color and style group controls"
        data-studio-chrome
      >
        <form id="style-group-form">
          <div class="panel-heading">
            <p class="selector-eyebrow">Your palette, your way</p>
            <h2 id="color-controls-title">Color controls / Page canvas</h2>
            <p>
              Assign your Tailwind palette colors to semantic theme tokens.
              Changes only affect the sample page.
            </p>
          </div>
          <p class="control-hint">
            Choose the editing area in the floating Tailwind palette. Sections
            1–6 use the first–sixth token groups. “Theme default” follows your
            existing light/dark theme. Choose Page canvas to edit page-wide
            brand and CTA colors.
          </p>
          {roleGroups.map((group) => (
            <fieldset class="color-fields" data-control-group={group.key}>
              <legend>{group.label}</legend>
              {colorRoles
                .filter(({ group: key }) => key === group.key)
                .map(({ key, label }) => (
                  <div
                    class="color-field"
                    data-color-field={key}
                    hidden={!isColorRoleVisible("page", key)}
                    role="group"
                    aria-labelledby={`color-label-${key}`}
                  >
                    <label id={`color-label-${key}`} for={`color-${key}`}>
                      {label}
                    </label>
                    <code data-role-token={key}>
                      {semanticToken("page", key) ?? "Preview-only override"}
                    </code>
                    <span
                      class="role-swatch"
                      data-role-swatch={key}
                      aria-hidden="true"
                    ></span>
                    <select id={`color-${key}`} data-role-value={key}>
                      <option value="theme" selected>
                        Theme default
                      </option>
                      <option value="custom">Custom hex…</option>
                      <optgroup label="Neutrals">
                        {["white", "black"].map((color) => (
                          <option value={`var(--color-${color})`}>
                            {color}
                          </option>
                        ))}
                      </optgroup>
                      {paletteFamilies.map(({ key: family, label }) => (
                        <optgroup label={label}>
                          {paletteColors
                            .filter((color) => color.startsWith(`${family}-`))
                            .map((color) => (
                              <option value={`var(--color-${color})`}>
                                {color}
                              </option>
                            ))}
                        </optgroup>
                      ))}
                    </select>
                    <input
                      type="text"
                      aria-label={`${label} hex`}
                      data-custom-role={key}
                      pattern="#[0-9a-fA-F]{6}"
                      maxlength={7}
                      placeholder="#317da6"
                      spellcheck="false"
                      hidden
                      disabled
                      required
                    />
                  </div>
                ))}
            </fieldset>
          ))}
          <button type="button" class="control-button" id="apply-all">
            Apply this palette to all six sections
          </button>
          <p class="control-hint">
            Replaces all six section palettes with the editing area's colors.
          </p>

          <div class="saved-groups">
            <h2>Style groups</h2>
            <p class="control-hint">
              A group saves light and dark token assignments. Stored in this
              browser; export a backup to reuse elsewhere.
            </p>
            <label for="saved-group">Saved groups</label>
            <select id="saved-group">
              <option value="">Unsaved palette</option>
            </select>
            <label for="group-name">Group name</label>
            <input
              id="group-name"
              type="text"
              placeholder="e.g. Coastal calm"
              maxlength={80}
              required
            />
            <div class="control-actions">
              <button
                type="submit"
                class="control-button control-primary"
                id="save-group"
              >
                Save group
              </button>
              <button type="button" class="control-button" id="new-group">
                Save as new
              </button>
              <button
                type="button"
                class="control-button"
                id="delete-group"
                disabled
              >
                Delete group
              </button>
            </div>
            <div class="control-actions">
              <button
                type="button"
                class="control-button"
                id="export-groups"
                disabled
              >
                Export JSON
              </button>
              <button type="button" class="control-button" id="import-groups">
                Import JSON
              </button>
              <input
                id="import-file"
                type="file"
                accept=".json,application/json"
                hidden
              />
            </div>
            <p id="selector-status" role="status" aria-live="polite"></p>
          </div>
        </form>
        <noscript>
          Enable JavaScript to edit colors and save style groups.
        </noscript>
      </aside>
    </div>
    <details class="palette-picker" data-studio-chrome open>
      <summary>
        Tailwind palette <span>Show / hide</span>
      </summary>
      <div class="palette-content">
        <p class="control-hint" id="theme-context"></p>
        <div class="palette-toolbar-scroll">
          <div class="palette-toolbar">
            <div class="palette-dropdowns">
              <div>
                <label for="editing-region">Editing area</label>
                <select id="editing-region">
                  {regions.map(({ key, label }) => (
                    <option value={key}>{label}</option>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-target">Assign palette color to</label>
                <select id="palette-target">
                  {roleGroups.map((group) => (
                    <optgroup label={group.label} data-target-group={group.key}>
                      {colorRoles
                        .filter(({ group: key }) => key === group.key)
                        .map(({ key, label }) => (
                          <option value={key}>
                            {group.label} / {label}
                          </option>
                        ))}
                    </optgroup>
                  ))}
                </select>
              </div>
              <div>
                <label for="palette-family">Palette family</label>
                <select id="palette-family">
                  <option value="custom" disabled>
                    Custom hex / no palette family
                  </option>
                  <option value="theme" disabled>
                    Theme default / no matching palette
                  </option>
                  <option value="neutral">White / black</option>
                  {paletteFamilies.map(({ key, label }) => (
                    <option value={key}>{label}</option>
                  ))}
                </select>
              </div>
            </div>
            <div
              class="palette-swatches"
              role="group"
              aria-label="Palette shades"
            >
              {paletteShades.map((shade) => (
                <button
                  type="button"
                  data-palette-shade={shade}
                  data-palette-value={`var(--color-maniac-mansion-${shade})`}
                  style={`background:var(--color-maniac-mansion-${shade})`}
                  aria-label={`maniac-mansion-${shade}`}
                  aria-pressed="false"
                  title={`maniac-mansion-${shade}`}
                >
                  <span>{shade}</span>
                </button>
              ))}
              {["white", "black"].map((color) => (
                <button
                  type="button"
                  data-palette-solid={color}
                  data-palette-value={`var(--color-${color})`}
                  style={`background:var(--color-${color})`}
                  aria-label={color}
                  aria-pressed="false"
                  title={color}
                >
                  <span>{color}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>
</Layout>

<script>
  import "../../scripts/style-selector";
</script>

<style>
  [data-studio-chrome] {
    background: var(--canvas-page);
    color: var(--ink-page);
  }
  .selector-shell {
    --selector-panel-width: 360px;
    width: calc(100% - var(--selector-panel-width));
  }
  .selector-shell {
    padding-bottom: calc(5rem + var(--selector-scroll-space, 0px));
  }
  .selector-eyebrow {
    color: var(--ink-page);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .selector-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.75rem;
  }
  .preview-column {
    min-width: 0;
  }
  .sample-container {
    width: 100%;
    max-width: var(--breakpoint-lg);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  [data-region] {
    background: var(--sample-background);
    color: var(--sample-text);
  }
  .sample-header > .sample-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
  }
  .sample-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .sample-logo-group {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }
  .sample-navigation {
    min-width: 0;
  }
  .sample-navigation > ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sample-navigation details {
    position: relative;
  }
  .sample-navigation summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    padding: 0.65rem 0.4rem;
    border-radius: 0.25rem;
    color: var(--sample-text);
    font-size: 0.75rem;
    font-weight: 650;
    list-style: none;
    cursor: pointer;
  }
  .sample-navigation summary::-webkit-details-marker {
    display: none;
  }
  .sample-navigation summary::after {
    content: "+";
  }
  .sample-navigation details[open] summary::after {
    content: "-";
  }
  .sample-navigation summary:hover,
  .sample-navigation details[open] summary {
    background: var(--sample-primary);
    color: var(--sample-primaryText);
  }
  .sample-submenu {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    z-index: 2;
    width: min(12rem, 70vw);
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border: 1px solid var(--sample-accentBorder);
    border-radius: 0.35rem;
    background: var(--sample-background);
    box-shadow: 0 8px 24px
      color-mix(in srgb, var(--sample-shadow) 15%, transparent);
  }
  .sample-navigation > ul > li:nth-child(n + 3) .sample-submenu {
    right: 0;
    left: auto;
  }
  .sample-submenu a {
    display: block;
    padding: 0.7rem;
    border-radius: 0.2rem;
    color: var(--sample-text);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .sample-submenu a:hover {
    background: var(--sample-primary);
    color: var(--sample-primaryText);
  }
  .sample-navigation summary:focus-visible,
  .sample-submenu a:focus-visible {
    outline: 2px solid var(--sample-accentFocus);
    outline-offset: 2px;
  }
  .sample-content {
    display: grid;
  }
  .sample-page-intro {
    padding-block: 2rem;
  }
  .sample-page-intro p:not(.sample-kicker) {
    font-size: 0.85rem;
    line-height: 1.75;
  }
  .sample-header .sample-buttons {
    margin: 0;
  }
  .sample-section {
    padding-block: clamp(1.25rem, 3vw, 3rem);
  }
  .sample-kicker {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sample-page h1 {
    color: var(--sample-h1);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 3.5rem);
    line-height: 1.05;
    margin: 1rem 0;
    letter-spacing: -0.025em;
  }
  .sample-page h2,
  .sample-footer h2 {
    color: var(--sample-h2);
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }
  .sample-page h3 {
    color: var(--sample-h3);
    font-size: 1rem;
    font-weight: 650;
    margin-bottom: 0.75rem;
  }
  .sample-section p:not(.sample-kicker),
  .sample-footer p {
    font-size: 0.85rem;
    line-height: 1.75;
  }
  .sample-copy {
    max-width: 39rem;
  }
  .sample-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .sample-buttons button {
    padding: 0.7rem 1rem;
    border: 1px solid var(--sample-accentBorder);
    border-radius: 0.3rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }
  .sample-buttons button:not([data-cta]):hover {
    background: var(--sample-accentFocus);
    color: var(--sample-primaryText);
  }
  .sample-buttons button:focus-visible {
    outline: 3px solid var(--sample-accentFocus);
    outline-offset: 3px;
  }
  .sample-primary {
    background: var(--sample-primary);
    color: var(--sample-primaryText);
  }
  .sample-secondary {
    background: var(--sample-secondary);
    color: var(--sample-secondaryText);
  }
  .sample-buttons [data-cta="primary"] {
    border-color: var(--cta-01);
  }
  .sample-buttons [data-cta="secondary"] {
    border-color: var(--cta-02);
  }
  .sample-buttons [data-cta]:hover {
    filter: brightness(0.95);
  }
  .sample-two-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    border-top: 1px solid var(--sample-border);
    padding-top: 1.5rem;
    margin-top: 2rem;
  }
  .sample-footer {
    padding-block: 2.5rem;
  }
  .selector-panel {
    position: fixed;
    top: var(--selector-header-offset, 0px);
    right: 0;
    z-index: 10;
    width: var(--selector-panel-width);
    height: calc(100dvh - var(--selector-header-offset, 0px));
    overflow-y: auto;
    padding: 1.5rem;
    border: 1px solid var(--canvas-page-border);
    border-radius: 0;
    background: var(--canvas-page);
  }
  .panel-heading h2,
  .saved-groups h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--ink-page-second-header);
    margin: 0.4rem 0 0.6rem;
  }
  .panel-heading > p:last-child,
  .control-hint {
    color: var(--ink-page);
    font-size: 0.75rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .selector-panel label,
  .palette-picker label,
  .color-fields legend {
    display: block;
    font-size: 0.75rem;
    font-weight: 650;
    margin-bottom: 0.45rem;
  }
  .selector-panel select,
  .palette-picker select,
  #group-name {
    width: 100%;
    padding: 0.65rem;
    border: 1px solid var(--canvas-page-border);
    border-radius: 0.35rem;
    background: var(--canvas-page);
    color: var(--ink-page);
    margin-bottom: 0.7rem;
    font-size: 0.8rem;
  }
  .color-fields {
    padding: 0;
    margin: 1rem 0;
    border: 0;
  }
  .color-field {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    padding: 0.65rem;
    margin-bottom: 0.5rem;
    border: 1px solid var(--canvas-page-border);
    border-radius: 0.4rem;
    cursor: pointer;
  }
  .color-field:hover {
    border-color: var(--accent-page-focus);
  }
  .color-field[data-active="true"],
  .color-field:focus-within {
    border-color: var(--accent-page-focus);
    box-shadow: inset 0 0 0 1px var(--accent-page-focus);
    background: color-mix(
      in srgb,
      var(--accent-page-focus) 8%,
      var(--canvas-page)
    );
  }
  .color-field label {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: 400;
    cursor: pointer;
  }
  .color-field code {
    grid-column: 1 / -1;
    color: var(--ink-page);
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }
  .role-swatch {
