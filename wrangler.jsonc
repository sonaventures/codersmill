{
  "$schema": "node_modules/wrangler/config-schema.json",
  // CodersMill on Cloudflare Workers: the static site, plus EmDash (the blog
  // CMS) and its admin at /_emdash, rendered on demand.
  "name": "codersmill",
  // The Cloudflare account (used by `npm run migrate` and deploys).
  "account_id": "283c0685e5101ed4a083f24b2c79254d",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  // EmDash's content database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codersmill",
      "database_id": "7c29c2aa-5bbb-4664-a3b0-ac6b887758bc",
    },
  ],
  // Astro's sessions (the Cloudflare adapter's SESSION binding).
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "0c26c4309d8142b59e97c1f095faaa25",
    },
  ],
  // Uploaded media. Create it with `wrangler r2 bucket create codersmill-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "codersmill-media",
    },
  ],
  // Co-editing rooms, one Durable Object per entry being edited.
  "durable_objects": {
    "bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
  },
  "exports": {
    "EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
  },
  // EmDash's maintenance and scheduled publishing.
  "triggers": {
    "crons": ["* * * * *"],
  },
}
